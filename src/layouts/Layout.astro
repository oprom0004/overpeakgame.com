---
export interface Props {
  title: string;
  description: string;
  schema?: object | object[];
}

const { title, description, schema } = Astro.props;
const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, 'https://overpeakgame.com').toString();

const navLinks = [
  { href: '/', label: 'Overview' },
  { href: '/download/', label: '📥 Download' },
  { href: '/powers/', label: '⚡ Superpowers' },
  { href: '/pc/', label: '🖥️ PC Setup' },
  { href: '/faq/', label: '❓ FAQ & Offline' },
  { href: '/codes/', label: '🎁 Codes' },
];
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <!-- Structured Data JSON-LD -->
  {schema && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(Array.isArray(schema) ? schema : [schema])}
    />
  )}
</head>
<body class="bg-op-darkest text-slate-100 font-sans min-h-screen flex flex-col selection:bg-op-laser selection:text-white">

  <!-- Top Release Alert Header -->
  <div class="bg-gradient-to-r from-op-laser/20 via-op-dark to-op-cryo/20 border-b border-op-border text-[11px] sm:text-xs py-1.5 px-4 text-center text-slate-300 font-mono">
    <span class="inline-block px-1.5 py-0.5 rounded bg-op-laser/20 text-op-laser font-bold mr-2 border border-op-laser/30">VERSION 0.6 EARLY ACCESS</span>
    <span>OverPeak Official Release Tracker • Android (Live on Google Play) • iOS & PC Setup Guide</span>
  </div>

  <!-- Main Navbar (Clean Internal Navigation ONLY) -->
  <header class="sticky top-0 z-50 backdrop-blur-md bg-op-darkest/92 border-b border-op-border/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-op-laser via-op-dark to-op-cryo p-[1px] shadow-glow-laser group-hover:scale-105 transition-transform">
          <div class="w-full h-full bg-op-darkest rounded-[11px] flex items-center justify-center font-mono font-black text-sm text-op-cryo">
            OP
          </div>
        </div>
        <div>
          <span class="font-mono font-black text-lg sm:text-xl tracking-tight text-white flex items-center gap-1.5">
            OVER<span class="text-op-laser">PEAK</span>
            <span class="text-[9px] px-1.5 py-0.5 rounded bg-op-laser/15 text-op-laser border border-op-laser/30 font-bold uppercase">GAME HUB</span>
          </span>
          <span class="hidden sm:block text-[10px] font-mono text-op-muted tracking-wider uppercase">
            Subject OP • Open-World Action
          </span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden md:flex items-center gap-1 font-mono text-xs uppercase tracking-wider font-semibold">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`px-3 py-2 rounded-lg transition-all ${
                isActive
                  ? 'bg-op-card text-op-cryo border border-op-cryo/40 shadow-sm'
                  : 'text-slate-300 hover:text-white hover:bg-op-card/60'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Right Action CTA -->
      <div class="flex items-center gap-3">
        <a
          href="/download/"
          class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-gradient-to-r from-op-laser to-rose-600 text-white font-mono font-bold text-xs uppercase tracking-wider shadow-glow-laser hover:brightness-110 transition-all"
        >
          <span>📥</span>
          <span>Get OverPeak</span>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button
          id="menuToggle"
          class="md:hidden p-2 rounded-lg bg-op-card border border-op-border text-slate-300 hover:text-white focus:outline-none"
          aria-label="Toggle navigation menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>

    <!-- Mobile Drawer Nav -->
    <div id="mobileMenu" class="hidden md:hidden border-t border-op-border bg-op-darkest/98 px-4 py-3 space-y-1">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`block px-3 py-2 rounded-lg text-sm font-mono font-medium ${
              isActive
                ? 'bg-op-card text-op-cryo font-bold'
                : 'text-slate-300 hover:text-white hover:bg-op-card/60'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </div>
  </header>

  <!-- Main Content Slot -->
  <main class="flex-grow">
    <slot />
  </main>

  <!-- Global Footer -->
  <footer class="border-t border-op-border bg-op-dark/60 mt-16 text-slate-400 text-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
        
        <!-- Col 1: Bio -->
        <div class="md:col-span-1">
          <div class="font-mono font-black text-white text-base mb-2">
            OVER<span class="text-op-laser">PEAK</span> GAME
          </div>
          <p class="text-op-muted text-xs leading-relaxed mb-4">
            The independent community resource, strategy wiki, and platform guide for OverPeak: Action Game by R-USER Games.
          </p>
          <div class="inline-block px-2.5 py-1 rounded bg-op-card border border-op-border font-mono text-[11px] text-op-green">
            ● Google Play Version 0.6 Live
          </div>
        </div>

        <!-- Col 2: Quick Links -->
        <div>
          <h4 class="font-mono font-bold text-white uppercase text-xs tracking-wider mb-3">Quick Directory</h4>
          <ul class="space-y-2 font-mono text-xs">
            <li><a href="/" class="hover:text-op-cryo transition-colors">Game Overview</a></li>
            <li><a href="/download/" class="hover:text-op-cryo transition-colors">Download &amp; Storefronts</a></li>
            <li><a href="/powers/" class="hover:text-op-cryo transition-colors">Superpowers Guide</a></li>
            <li><a href="/pc/" class="hover:text-op-cryo transition-colors">PC 60 FPS Setup</a></li>
            <li><a href="/faq/" class="hover:text-op-cryo transition-colors">Offline Status &amp; FAQ</a></li>
            <li><a href="/codes/" class="hover:text-op-cryo transition-colors">Promo Codes</a></li>
          </ul>
        </div>

        <!-- Col 3: Strategy & Platforms -->
        <div>
          <h4 class="font-mono font-bold text-white uppercase text-xs tracking-wider mb-3">Platforms &amp; Gameplay</h4>
          <ul class="space-y-2 font-mono text-xs">
            <li><a href="/download/#android" class="hover:text-op-cryo transition-colors">Android (Google Play)</a></li>
            <li><a href="/download/#ios" class="hover:text-op-cryo transition-colors">iOS App Store Status</a></li>
            <li><a href="/pc/#controls" class="hover:text-op-cryo transition-colors">Keyboard &amp; Mouse Controls</a></li>
            <li><a href="/powers/#destruction" class="hover:text-op-cryo transition-colors">Building Destruction Engine</a></li>
            <li><a href="/faq/#reputation" class="hover:text-op-cryo transition-colors">Hero vs Villain Reputation</a></li>
          </ul>
        </div>

        <!-- Col 4: Legal & Disclaimer -->
        <div>
          <h4 class="font-mono font-bold text-white uppercase text-xs tracking-wider mb-3">Notice &amp; Disclaimer</h4>
          <p class="text-[11px] text-slate-500 leading-relaxed">
            OverPeak is developed and published by R-USER Games. OverPeakGame.com is an independent fan-made tactical knowledge portal and is not directly affiliated with, sponsored by, or endorsed by R-USER Games. All trademarks and copyrights belong to their respective owners.
          </p>
        </div>

      </div>

      <!-- Copyright Bar -->
      <div class="border-t border-op-border/50 pt-6 flex flex-col sm:flex-row items-center justify-between text-[11px] text-slate-500 font-mono">
        <div>
          &copy; 2026 OverPeakGame.com. All rights reserved.
        </div>
        <div class="mt-2 sm:mt-0 flex gap-4">
          <a href="/download/" class="hover:underline">Download Hub</a>
          <a href="/faq/" class="hover:underline">FAQ</a>
          <a href="/sitemap.xml" class="hover:underline">Sitemap</a>
        </div>
      </div>
    </div>
  </footer>

  <script>
    const toggle = document.getElementById('menuToggle');
    const menu = document.getElementById('mobileMenu');
    toggle?.addEventListener('click', () => {
      menu?.classList.toggle('hidden');
    });
  </script>
</body>
</html>
