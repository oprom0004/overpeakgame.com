---
import Layout from '../layouts/Layout.astro';

const pageTitle = 'OverPeak Promo Codes & Rewards Guide – How Superpowers & Skins Unlock';
const pageDescription = 'Guide to OverPeak: Action Game promo codes, reward unlocks, and progression mechanics. Learn how in-game abilities and skins are earned naturally without cheats.';

const codesSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://overpeakgame.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Codes",
          "item": "https://overpeakgame.com/codes/"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Are there any promo codes or redeem buttons in OverPeak?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. OverPeak does not feature a promo code redemption box or text entry console. All content is unlocked through organic gameplay."
          }
        },
        {
          "@type": "Question",
          "name": "How do you unlock superpowers and skins in OverPeak?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "All superpowers, weapon upgrades, and player skins are earned purely through story progression, completing open-world challenges, and looting hidden caches."
          }
        }
      ]
    }
  ]
};

const unlockRoadmap = [
  { item: 'Thermal Laser Vision', method: 'Complete Mission 01: Breakout & Escape', type: 'Superpower' },
  { item: 'Cryo Freeze Ray', method: 'Infiltrate Starbridge Sub-Level Cryo Lab', type: 'Superpower' },
  { item: 'Telekinetic Force Grip', method: 'Liberate Industrial Sector 07 Outpost', type: 'Superpower' },
  { item: 'Sonic Mach-2 Flight', method: 'Scale and Overcharge the Prism Broadcast Spire', type: 'Superpower' },
  { item: 'Vanguard Tactical Armor', method: 'Find 10 Hidden Underground Resistance Crates', type: 'Suit Cosmetic' },
  { item: 'Crimson Fury Shroud', method: 'Achieve Tier 5 Notoriety on the Villain Alignment Path', type: 'Suit Cosmetic' },
];
---

<Layout title={pageTitle} description={pageDescription} schema={codesSchema}>

  <!-- Clean Page Header (Matching Homepage Style) -->
  <section class="border-b border-op-border bg-gradient-to-b from-op-darkest via-op-dark to-op-darkest py-10 sm:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="font-mono text-xs text-slate-400 mb-4 flex items-center gap-2">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-white">Promo Codes &amp; Rewards</span>
      </nav>

      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-op-card border border-op-border text-[11px] font-mono text-slate-300 uppercase tracking-wider mb-4">
          <span class="w-2 h-2 rounded-full bg-op-green"></span>
          <span>In-Game Progression Guide</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black text-white font-display uppercase tracking-tight mb-3">
          OverPeak Promo Codes &amp; Unlocks
        </h1>

        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          Understanding the progression architecture in <strong>OverPeak: Action Game</strong>. Discover legitimate in-game unlock pathways and avoid unauthorized third-party code generator scams.
        </p>
      </div>

    </div>
  </section>

  <!-- Legit Unlock Roadmap Table -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-8">
      <h2 class="text-2xl font-black text-white font-display uppercase tracking-tight mb-1">
        How to Unlock Abilities &amp; Suits in Gameplay
      </h2>
      <p class="text-slate-400 text-xs font-mono">
        All superpowers and cosmetics are earned naturally without payments or codes
      </p>
    </div>

    <div class="overflow-x-auto rounded-2xl border border-op-border bg-op-card shadow-lg">
      <table class="w-full text-left font-mono text-xs border-collapse">
        <thead class="bg-op-dark border-b border-op-border text-slate-400 uppercase text-[11px]">
          <tr>
            <th class="p-4 sm:p-5 w-1/3">Item / Reward</th>
            <th class="p-4 sm:p-5 w-1/4">Category</th>
            <th class="p-4 sm:p-5 w-5/12 text-white">Verified Gameplay Unlock Requirement</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-op-border/50 text-slate-300">
          {unlockRoadmap.map((item) => (
            <tr class="hover:bg-white/5 transition-colors">
              <td class="p-4 sm:p-5 text-white font-bold">{item.item}</td>
              <td class="p-4 sm:p-5">
                <span class="px-2 py-0.5 rounded bg-op-dark border border-op-border text-slate-300 text-[11px]">
                  {item.type}
                </span>
              </td>
              <td class="p-4 sm:p-5 text-slate-200">{item.method}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Security Advisory -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-op-border">
    <div class="p-6 sm:p-8 rounded-2xl bg-op-card border border-op-border shadow-lg">
      <h3 class="text-xl sm:text-2xl font-bold text-white mb-3 font-display uppercase tracking-tight">
        Why OverPeak Does Not Use Promo Codes
      </h3>
      <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-6">
        OverPeak is designed as a standalone offline-first sandbox game. Developer R-USER Games does not maintain a server-side gift code system or in-game redemption dialog. Be cautious of third-party websites claiming to offer unlimited money generators:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs font-mono text-slate-300">
        <div class="p-4 rounded-xl bg-op-dark border border-op-border">
          <h4 class="text-white font-bold mb-1 font-sans text-sm">No Redemption Engine</h4>
          <p class="text-slate-400 font-sans text-xs">The game client has no internal code parser. Any promotional codes distributed online are completely fabricated.</p>
        </div>
        <div class="p-4 rounded-xl bg-op-dark border border-op-border">
          <h4 class="text-white font-bold mb-1 font-sans text-sm">Phishing &amp; Malware Risks</h4>
          <p class="text-slate-400 font-sans text-xs">Websites advertising generator tools typically redirect users to survey traps or malicious APK downloads.</p>
        </div>
        <div class="p-4 rounded-xl bg-op-dark border border-op-border">
          <h4 class="text-white font-bold mb-1 font-sans text-sm">Protect Account Data</h4>
          <p class="text-slate-400 font-sans text-xs">Never provide your Google account credentials or passwords to external sites promising free currency.</p>
        </div>
      </div>
    </div>
  </section>

</Layout>
