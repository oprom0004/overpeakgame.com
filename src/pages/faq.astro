---
import Layout from '../layouts/Layout.astro';

const pageTitle = 'Is OverPeak Offline? Complete FAQ, Story Lore & Specs Guide';
const pageDescription = 'Frequently asked questions about OverPeak: Action Game. Learn whether OverPeak is offline or requires Wi-Fi, iOS release date, Subject OP storyline, and hero vs villain reputation.';

const faqs = [
  {
    q: 'Is OverPeak an offline game or does it require constant internet?',
    a: 'OverPeak CAN be played fully offline without Wi-Fi or cellular data! The core Prism City open-world sandbox, story missions, and building destruction physics all run locally on your device. An internet connection is only needed when downloading initial game data, saving cloud backups to your Google account, or checking for Version 0.6 patch updates.',
    category: 'Connectivity',
    badge: '100% Offline Capable'
  },
  {
    q: 'Can OverPeak be played on Apple iOS (iPhone/iPad)?',
    a: 'R-USER Games initially released OverPeak for Android on the Google Play Store. The native iOS edition is currently in development for iPhone and iPad with Apple Metal 3 graphics. iOS users looking to play immediately can experience the full game on PC or Mac using desktop emulators like MuMuPlayer 12.',
    category: 'Platforms',
    badge: 'iOS Availability'
  },
  {
    q: 'Who is Jason Fieldway (Subject OP)? What is the story of OverPeak?',
    a: 'Jason Fieldway is a former civilian who was abducted and genetically modified by the mega-corporation Starbridge in an attempt to engineer the ultimate living biological weapon—codenamed Subject OP. After awakening from cryogenic stasis, Jason vows revenge against Starbridge executives and their private military force in Prism City.',
    category: 'Lore',
    badge: 'Subject OP Origin'
  },
  {
    q: 'How does the Reputation System work in OverPeak?',
    a: 'Every action in Prism City influences your reputation meter. Rescuing civilians from Starbridge drones, stopping bank heists, and avoiding destruction of civilian infrastructure turns you into a Hero (citizens cheer and offer support). Recklessly demolishing apartment blocks and attacking police turns you into a feared Villain, summoning heavier Starbridge military gunships.',
    category: 'Gameplay',
    badge: 'Hero vs Villain'
  },
  {
    q: 'Is OverPeak planned for a native Steam or PC release?',
    a: 'R-USER Games has indicated interest in bringing OverPeak to PC and consoles in the future. However, there is no official Steam release date currently. PC players can seamlessly play right now using Android emulators like MuMuPlayer 12 or BlueStacks 5 at 60–120 FPS.',
    category: 'Platforms',
    badge: '120 FPS Emulation'
  },
  {
    q: 'How much free storage does OverPeak require on Android?',
    a: 'The initial Google Play download package is approximately 1.2 GB. After first boot and shader pre-compilation, the game consumes approximately 2.2 GB of total internal storage. We recommend having at least 3.0 GB of free space for smooth performance.',
    category: 'Hardware',
    badge: '~2.2 GB Final Size'
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://overpeakgame.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "FAQ",
          "item": "https://overpeakgame.com/faq/"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map((item) => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} schema={faqSchema}>

  <!-- Clean Page Header (Matching Homepage Style) -->
  <section class="border-b border-op-border bg-gradient-to-b from-op-darkest via-op-dark to-op-darkest py-10 sm:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="font-mono text-xs text-slate-400 mb-4 flex items-center gap-2">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-white">FAQ &amp; Offline Guide</span>
      </nav>

      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-op-card border border-op-border text-[11px] font-mono text-slate-300 uppercase tracking-wider mb-4">
          <span class="w-2 h-2 rounded-full bg-op-green"></span>
          <span>Technical &amp; Gameplay FAQ</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black text-white font-display uppercase tracking-tight mb-3">
          OverPeak FAQ &amp; Offline Guide
        </h1>

        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          Frequently asked questions regarding OverPeak: Action Game. Comprehensive details on offline gameplay, platform compatibility, PC emulation setup, and gameplay mechanics.
        </p>
      </div>

    </div>
  </section>

  <!-- Offline Capabilities Overview -->
  <section class="py-8 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="p-6 sm:p-8 rounded-2xl bg-op-card border border-op-border shadow-lg">
      <div class="flex items-center justify-between flex-wrap gap-4 mb-4">
        <h2 class="text-xl sm:text-2xl font-bold text-white font-display">
          Can OverPeak Be Played Completely Offline?
        </h2>
        <span class="px-3 py-1 rounded-full bg-op-dark border border-op-border text-slate-300 font-mono text-xs">
          Offline Capable
        </span>
      </div>

      <p class="text-slate-300 text-sm leading-relaxed mb-6">
        OverPeak can be played completely offline. You do not need Wi-Fi or mobile cellular data to explore Prism City, fight Starbridge mercenaries, or trigger real-time building collapses. All physics simulations and story campaigns run locally on your device's processor.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-op-border text-xs font-mono text-slate-300">
        <div class="p-3 rounded-lg bg-op-dark border border-op-border">
          <span class="text-white font-bold block mb-1">Offline Story Missions</span>
          <span class="text-slate-400">All campaign chapters playable offline</span>
        </div>
        <div class="p-3 rounded-lg bg-op-dark border border-op-border">
          <span class="text-white font-bold block mb-1">Physics Simulation</span>
          <span class="text-slate-400">100% on-device CPU/GPU processing</span>
        </div>
        <div class="p-3 rounded-lg bg-op-dark border border-op-border">
          <span class="text-white font-bold block mb-1">Network Access</span>
          <span class="text-slate-400">Required only for cloud backups and game updates</span>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Grid -->
  <section class="py-8 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-4">
      <div>
        <h2 class="text-2xl sm:text-3xl font-black text-white font-display uppercase tracking-tight">
          Common Questions &amp; Answers
        </h2>
        <p class="text-slate-400 text-sm mt-1">
          Detailed answers regarding installation, gameplay systems, and platform status.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {faqs.map((faq) => (
        <div class="p-6 rounded-2xl bg-op-card border border-op-border hover:border-slate-500 transition-all shadow-lg flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="px-2.5 py-0.5 rounded bg-op-dark border border-op-border text-[11px] font-mono text-slate-300 uppercase">
                {faq.category}
              </span>
              <span class="font-mono text-[11px] text-slate-500">{faq.badge}</span>
            </div>
            <h3 class="text-lg font-bold text-white mb-3 font-display">
              {faq.q}
            </h3>
            <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-4">
              {faq.a}
            </p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Cross-Nav Hub -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-op-border">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-6 p-8 rounded-2xl bg-op-card border border-op-border shadow-xl">
      <div>
        <h3 class="text-2xl font-black text-white font-display uppercase tracking-tight mb-1">
          Explore OverPeak Guides
        </h3>
        <p class="text-slate-300 text-xs sm:text-sm">
          Download the official build or read detailed walkthroughs for PC configuration and superpowers.
        </p>
      </div>
      <div class="flex gap-3 flex-wrap">
        <a
          href="/download/"
          class="px-5 py-2.5 rounded-lg bg-white hover:bg-slate-200 text-black font-semibold text-xs uppercase tracking-wider transition-colors"
        >
          Download Hub
        </a>
        <a
          href="/powers/"
          class="px-5 py-2.5 rounded-lg bg-op-dark border border-op-border text-white hover:border-slate-400 font-semibold text-xs uppercase tracking-wider transition-colors"
        >
          Superpowers Guide
        </a>
      </div>
    </div>
  </section>

</Layout>
