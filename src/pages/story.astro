---
import Layout from '../layouts/Layout.astro';

const pageTitle = 'The Story of OverPeak – Subject OP, Starbridge Corporation & Lore';
const pageDescription = 'Uncover the lore of OverPeak: Action Game. Learn how Jason Fieldway was transformed into Subject OP, the crimes of Starbridge Corp, and the open-world districts of Prism City.';

const storySchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://overpeakgame.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Story & Lore",
          "item": "https://overpeakgame.com/story/"
        }
      ]
    },
    {
      "@type": "Article",
      "headline": "OverPeak Narrative Lore: Subject OP Origin & Starbridge Conspiracy",
      "description": "Comprehensive narrative dossier exploring Jason Fieldway's genetic origins, the Starbridge Corporation PMC escalation, and the four districts of Prism City.",
      "author": {
        "@type": "Organization",
        "name": "OverPeak Lore Archive"
      }
    }
  ]
};

const districts = [
  {
    name: 'Downtown Metropolis',
    threat: 'Moderate Threat',
    desc: 'The corporate heart of Prism City, dominated by 80-story glass skyscrapers, high-speed rail viaducts, and constant Starbridge surveillance blimps. Ideal for high-altitude sonic flight and structural column demolition.',
    threats: ['Attack Choppers', 'Sniper Nests', 'Tactical SWAT Barricades']
  },
  {
    name: 'Industrial Sector 07',
    threat: 'High Danger',
    desc: 'Heavy manufacturing complex housing chemical storage tanks, shipping container yards, and Starbridge robotics testing proving grounds. Abundant heavy machinery available for telekinetic launches.',
    threats: ['Armored Walkers', 'Heavy Combat Mechs', 'Laser Defense Turrets']
  },
  {
    name: 'The Undergrid Slums',
    threat: 'Low Threat',
    desc: 'Densely populated neon alleyways beneath the elevated highway system. Hostile toward Starbridge enforcers; players with positive Hero reputation will receive intelligence on hidden weapon caches from local resistance cells.',
    threats: ['Guerilla Drones', 'Private Security Patrols']
  },
  {
    name: 'Starbridge Citadel',
    threat: 'Max Threat Level',
    desc: 'The fortified corporate headquarters complex shielded by localized EMP barriers and automated surface-to-air missile batteries. The ultimate endgame confrontation zone for Subject OP.',
    threats: ['Apex Mech Bosses', 'Titanium Blast Doors', 'Energy Shields']
  }
];
---

<Layout title={pageTitle} description={pageDescription} schema={storySchema}>

  <!-- Clean Page Header (Matching Homepage Style) -->
  <section class="border-b border-op-border bg-gradient-to-b from-op-darkest via-op-dark to-op-darkest py-10 sm:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="font-mono text-xs text-slate-400 mb-4 flex items-center gap-2">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-white">Story &amp; Lore</span>
      </nav>

      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-op-card border border-op-border text-[11px] font-mono text-slate-300 uppercase tracking-wider mb-4">
          <span class="w-2 h-2 rounded-full bg-op-green"></span>
          <span>World Narrative &amp; Character Lore</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black text-white font-display uppercase tracking-tight mb-3">
          The Story of OverPeak: Subject OP
        </h1>

        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          Explore the narrative behind <strong>OverPeak</strong>. Discover how Jason Fieldway was transformed into a bio-weapon, the corporate crimes of Starbridge Syndicate, and the open-world sectors of Prism City.
        </p>
      </div>

    </div>
  </section>

  <!-- Narrative Dossier & Character Profile -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Character Bio Card -->
      <div class="p-6 rounded-2xl bg-op-card border border-op-border shadow-lg flex flex-col justify-between">
        <div>
          <div class="w-full aspect-square rounded-xl bg-op-dark border border-op-border overflow-hidden mb-6 relative group">
            <img src="/images/hero-banner.jpg" alt="Subject OP Jason Fieldway over Prism City" class="w-full h-full object-cover" />
            <div class="absolute bottom-2 left-2 px-2.5 py-1 rounded bg-black/85 font-mono text-[10px] text-white font-bold border border-white/10">
              Subject OP Profile
            </div>
          </div>

          <h2 class="text-2xl font-black text-white font-display uppercase tracking-tight mb-1">
            Jason Fieldway
          </h2>
          <p class="font-mono text-xs text-slate-400 mb-4 uppercase">
            Designation: Subject OP-001
          </p>

          <ul class="space-y-2 text-xs font-mono text-slate-300 border-t border-op-border/60 pt-4">
            <li class="flex justify-between pb-1.5 border-b border-op-border/30">
              <span class="text-slate-400">Biological Age:</span>
              <span class="text-white">Unknown (Cryo Stasis)</span>
            </li>
            <li class="flex justify-between pb-1.5 border-b border-op-border/30">
              <span class="text-slate-400">Thermal Output:</span>
              <span class="text-white">3,200°C Focused Plasma</span>
            </li>
            <li class="flex justify-between pb-1.5 border-b border-op-border/30">
              <span class="text-slate-400">Cryo Threshold:</span>
              <span class="text-white">-273.15°C Absolute Zero</span>
            </li>
            <li class="flex justify-between">
              <span class="text-slate-400">Flight Velocity:</span>
              <span class="text-white">Mach 2.2 Terminal</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Starbridge Conspiracy Background -->
      <div class="lg:col-span-2 p-8 rounded-2xl bg-op-card border border-op-border shadow-lg flex flex-col justify-between">
        <div>
          <h2 class="text-2xl sm:text-3xl font-black text-white font-display uppercase tracking-tight mb-4">
            The Starbridge Corporation Syndicate
          </h2>
          <p class="text-slate-300 text-sm leading-relaxed mb-4">
            Prism City was promoted to the public as a futuristic smart-city powered by Starbridge clean-energy reactors. Behind the polished corporate glass facades, Starbridge was secretly contracting private military security forces (PMC) and conducting illegal bio-synthetic genetic trials on non-consenting citizens.
          </p>
          <p class="text-slate-300 text-sm leading-relaxed mb-6">
            When facility containment failed, Jason Fieldway broke through reinforced blast barriers, neutralizing the research team. In response, Starbridge declared total martial law, dispatching attack gunships, sniper squads, and heavy armored walkers across Prism City.
          </p>
        </div>

        <!-- Karma System Comparison -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 border-t border-op-border/60 pt-6 font-mono text-xs">
          <div class="p-5 rounded-xl bg-op-dark border border-op-border">
            <div class="text-white font-bold text-sm mb-1.5 font-sans">
              Heroic Protector Path
            </div>
            <p class="text-slate-300 text-xs leading-relaxed font-sans">
              Civilians actively assist with intelligence, unlocking hidden resistance weapon caches. City authorities generate less hostility, allowing surgical strikes on corporate facilities.
            </p>
          </div>
          <div class="p-5 rounded-xl bg-op-dark border border-op-border">
            <div class="text-white font-bold text-sm mb-1.5 font-sans">
              Villainous Destroyer Path
            </div>
            <p class="text-slate-300 text-xs leading-relaxed font-sans">
              Uncapped building destruction score multipliers. Triggers maximum Starbridge PMC manhunts, summoning apex combat walker bosses and unleashing catastrophic rage abilities.
            </p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Prism City Districts -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-op-border">
    <div class="mb-8">
      <h2 class="text-2xl font-black text-white font-display uppercase tracking-tight mb-1">
        Prism City Open-World Sectors
      </h2>
      <p class="text-slate-400 text-xs font-mono">
        Explore destructible urban districts across the metropolitan grid
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {districts.map((district) => (
        <div class="p-6 rounded-2xl bg-op-card border border-op-border hover:border-slate-500 transition-all shadow-lg flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
              <h3 class="text-xl font-bold text-white font-display">{district.name}</h3>
              <span class="font-mono text-xs px-2.5 py-0.5 rounded bg-op-dark border border-op-border text-slate-300">
                {district.threat}
              </span>
            </div>
            <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-6">{district.desc}</p>
          </div>

          <div class="border-t border-op-border/60 pt-4">
            <span class="font-mono text-[11px] text-slate-400 uppercase block mb-2">Tactical Threats:</span>
            <div class="flex flex-wrap gap-2">
              {district.threats.map((threat) => (
                <span class="px-2.5 py-1 rounded bg-op-dark border border-op-border font-mono text-xs text-slate-300">
                  {threat}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

</Layout>
