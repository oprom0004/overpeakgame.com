---
import Layout from '../layouts/Layout.astro';

const pageTitle = 'The Story of OverPeak – Subject OP, Starbridge Corporation & Lore';
const pageDescription = 'Uncover the dark lore of OverPeak: Action Game. Learn how Jason Fieldway was transformed into Subject OP, the crimes of Starbridge Corp, and the open-world districts of Prism City.';

const storySchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://overpeakgame.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Story & Lore",
          "item": "https://overpeakgame.com/story/"
        }
      ]
    },
    {
      "@type": "Article",
      "headline": "OverPeak Narrative Lore: Subject OP Origin & Starbridge Conspiracy",
      "description": "Comprehensive narrative dossier exploring Jason Fieldway's genetic origins, the Starbridge Corporation PMC escalation, and the four districts of Prism City.",
      "author": {
        "@type": "Organization",
        "name": "OverPeak Lore Archive"
      }
    }
  ]
};

const districts = [
  {
    name: 'Downtown Metropolis',
    danger: 'Tier 3 Danger',
    desc: 'The corporate heart of Prism City, dominated by 80-story glass skyscrapers, high-speed rail viaducts, and constant Starbridge surveillance blimps. Ideal for high-altitude sonic flight and structural column demolition.',
    threats: ['Attack Choppers', 'Sniper Nests', 'Tactical SWAT']
  },
  {
    name: 'Industrial Sector 07',
    danger: 'Tier 4 Danger',
    desc: 'Heavy manufacturing complex housing chemical storage tanks, shipping container yards, and Starbridge robotics testing proving grounds. Abundant heavy machinery available for telekinetic launches.',
    threats: ['Armored Walkers', 'Heavy Mechs', 'Laser Turrets']
  },
  {
    name: 'The Undergrid Slums',
    danger: 'Tier 2 Danger',
    desc: 'Densely populated neon alleyways beneath the elevated highway system. Hostile toward Starbridge enforcers; players with positive Hero reputation will receive intelligence on hidden weapon caches from local resistance cells.',
    threats: ['Guerilla Drones', 'Private Security Patrols']
  },
  {
    name: 'Starbridge Citadel',
    danger: 'Tier 5 Max Threat',
    desc: 'The fortified corporate headquarters complex shielded by localized EMP barriers and automated surface-to-air missile batteries. The ultimate endgame confrontation zone for Subject OP.',
    threats: ['Apex Mech Bosses', 'Titanium Blast Doors', 'Energy Shields']
  }
];
---

<Layout title={pageTitle} description={pageDescription} schema={storySchema}>

  <!-- Page Header with Game Atmosphere -->
  <section class="border-b border-op-border bg-op-darkest relative overflow-hidden py-12">
    <div class="absolute inset-0 opacity-10 bg-cover bg-center pointer-events-none" style="background-image: url('/images/hero-banner.jpg');"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-op-darkest via-op-darkest/90 to-transparent"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <nav class="font-mono text-xs text-slate-400 mb-6 flex items-center gap-2">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-white">Story &amp; Lore</span>
      </nav>

      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded bg-white/5 border border-white/10 text-xs font-mono text-slate-300 mb-3">
          <span>Official Lore &amp; World Dossier</span>
          <span>• Subject OP Archive</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-black text-white font-display uppercase tracking-tight mb-4">
          The Story of OverPeak: Subject OP &amp; Starbridge
        </h1>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          Explore the narrative behind <strong>OverPeak</strong>. Discover how Jason Fieldway was transformed into a bio-weapon, the corporate crimes of Starbridge, and the open-world sectors of Prism City.
        </p>
      </div>

    </div>
  </section>

  <!-- Lore Overview Box (Clean Wiki Briefing) -->
  <section class="py-8 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="p-6 sm:p-8 rounded-2xl bg-op-card border border-op-border">
      <span class="font-mono text-xs text-slate-400 uppercase tracking-wider block mb-1">
        CHARACTER DOSSIER // BIOLOGICAL PROFILE
      </span>
      <h2 class="text-xl sm:text-2xl font-black text-white font-display mb-2">
        Who is Jason Fieldway (Subject OP)?
      </h2>
      <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-3">
        In <em>OverPeak: Action Game</em>, <strong>Jason Fieldway</strong> is the biological test subject designated <strong>Subject OP</strong>. Experimented on by the corrupt conglomerate <strong>Starbridge Corporation</strong> in Prism City, he was infused with gene-spliced gravitational anomalies, thermal optical radiation, and sub-zero cellular synthesis. After breaking free from stasis, players choose between seeking targeted retribution against corporate leadership (Hero Path) or unleashing unfettered apocalyptic revenge upon the entire metropolis (Villain Path).
      </p>
      <div class="flex flex-wrap gap-4 font-mono text-xs text-slate-400 pt-3 border-t border-op-border/50">
        <div><strong class="text-slate-200">Antagonist:</strong> Starbridge PMC</div>
        <div><strong class="text-slate-200">Setting:</strong> Prism City Metropolis</div>
        <div><strong class="text-slate-200">Morality:</strong> Dynamic Karma System</div>
      </div>
    </div>
  </section>

  <!-- Narrative Dossier & Character Profile (Clean Monochrome) -->
  <section class="py-8 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Character Bio Card -->
      <div class="p-6 rounded-2xl bg-op-card border border-op-border">
        <div class="w-full aspect-square rounded-xl bg-op-dark border border-op-border overflow-hidden mb-6 relative">
          <img src="/images/hero-banner.jpg" alt="Subject OP Jason Fieldway over Prism City" class="w-full h-full object-cover" />
          <div class="absolute bottom-2 left-2 px-2 py-0.5 rounded bg-black/80 font-mono text-[10px] text-white font-bold border border-white/10">
            SUBJECT OP // BIO-RECORD
          </div>
        </div>
        <h3 class="text-xl font-bold text-white font-display uppercase mb-1">Jason Fieldway</h3>
        <p class="font-mono text-xs text-slate-400 mb-4 uppercase">Designation: Subject OP-001</p>
        <div class="space-y-2 text-xs font-mono text-slate-300 border-t border-op-border/60 pt-4">
          <div class="flex justify-between">
            <span class="text-slate-400">Biological Age:</span>
            <span class="text-white font-semibold">Unknown (Cryo-Preserved)</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400">Thermal Output:</span>
            <span class="text-white font-semibold">3,200°C Focused Beam</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400">Cryo Threshold:</span>
            <span class="text-white font-semibold">-273.15°C (Absolute Zero)</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400">Flight Velocity:</span>
            <span class="text-white font-semibold">Mach 2.2 Terminal</span>
          </div>
        </div>
      </div>

      <!-- Starbridge Conspiracy Background -->
      <div class="lg:col-span-2 p-8 rounded-2xl bg-op-card border border-op-border flex flex-col justify-between">
        <div>
          <span class="px-2.5 py-1 rounded bg-white/5 border border-white/10 text-slate-300 font-mono text-xs font-bold uppercase mb-4 inline-block">
            CORPORATE ANTAGONIST
          </span>
          <h3 class="text-2xl sm:text-3xl font-black text-white font-display uppercase tracking-tight mb-4">
            The Starbridge Corporation Syndicate
          </h3>
          <p class="text-slate-300 text-sm leading-relaxed mb-4">
            Prism City was once promised as a utopian smart-city powered by Starbridge clean-energy reactors. Behind the polished architectural glass facades, Starbridge was secretly contracting private military security forces and conducting illegal genetic enhancement trials on non-consenting citizens.
          </p>
          <p class="text-slate-300 text-sm leading-relaxed mb-6">
            When the facility containment failed during the Version 0.6 timeline, Jason Fieldway broke through blast doors, slaughtering the tier-1 research squad. Starbridge placed Prism City under complete martial law, deploying gunship fleets and mechanized combat walkers to recapture their investment.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 border-t border-op-border/60 pt-6 font-mono text-xs">
          <div class="p-4 rounded-xl bg-op-dark border border-op-border">
            <div class="text-white font-bold mb-1">Heroic Path Perks</div>
            <p class="text-slate-400 text-[11px] leading-relaxed">Civilians actively assist with weapon caches and distract police; lower heat generation from city authorities.</p>
          </div>
          <div class="p-4 rounded-xl bg-op-dark border border-op-border">
            <div class="text-white font-bold mb-1">Villainous Path Perks</div>
            <p class="text-slate-400 text-[11px] leading-relaxed">Uncapped destruction multipliers, unlock devastating apocalyptic rage ground-slams, Starbridge sends elite mechs.</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Prism City Open-World Map Districts -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-op-border">
    <div class="mb-8">
      <span class="px-2.5 py-0.5 rounded bg-white/5 border border-white/10 text-slate-300 font-mono text-xs font-bold uppercase mb-3 inline-block">
        TACTICAL CARTOGRAPHY
      </span>
      <h2 class="text-2xl sm:text-3xl font-black text-white font-display uppercase tracking-tight">
        Prism City Open-World Sectors
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {districts.map((district) => (
        <div class="p-6 rounded-2xl bg-op-card border border-op-border hover:border-white/20 transition-all">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-xl font-bold text-white font-display">{district.name}</h3>
            <span class="font-mono text-xs text-slate-300 font-bold px-2 py-0.5 rounded bg-op-dark border border-op-border">{district.danger}</span>
          </div>
          <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-4">{district.desc}</p>
          <div class="border-t border-op-border/60 pt-3">
            <span class="font-mono text-[11px] text-slate-400 uppercase block mb-2">Tactical Threats:</span>
            <div class="flex flex-wrap gap-2">
              {district.threats.map((threat) => (
                <span class="px-2 py-0.5 rounded bg-op-dark border border-op-border font-mono text-[11px] text-slate-300">
                  {threat}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

</Layout>
