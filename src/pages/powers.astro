---
import Layout from '../layouts/Layout.astro';

const pageTitle = 'OverPeak Superpowers & Destruction Guide – Thermal Laser, Cryo & Flight';
const pageDescription = 'Master all Subject OP abilities in OverPeak: Action Game. Guide to Thermal Laser Vision, Cryo Freeze, Telekinesis, Sonic Flight, and real-time building demolition physics.';

const powersSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://overpeakgame.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Superpowers",
          "item": "https://overpeakgame.com/powers/"
        }
      ]
    },
    {
      "@type": "Article",
      "headline": "OverPeak Superpowers & Building Destruction Physics Guide",
      "description": "Comprehensive tactical guide covering all five Subject OP abilities, building collapse mechanics, and combat synergies in Prism City.",
      "author": {
        "@type": "Organization",
        "name": "OverPeak Strategy Team"
      }
    }
  ]
};

const abilities = [
  {
    id: 'laser',
    code: '01',
    title: 'Thermal Laser Vision',
    category: 'Sustained Optical Beam',
    image: '/images/hero-banner.jpg',
    imageAlt: 'OverPeak Thermal Laser Vision destroying skyscraper support columns in Prism City',
    stats: { damage: '95 / 100', range: '120 meters', consumption: 'Medium / sec', cooldown: 'Instant' },
    summary: 'Subject OP unleashes twin high-temperature optical plasma beams from the retinas, generating pinpoint thermal erosion that cuts through titanium armor plates, fuel drums, and reinforced concrete pillar cores.',
    tips: [
      'Sweep beams horizontally across building base columns to trigger structural failure.',
      'Target patrol vehicle fuel tanks from high altitude for chain explosions.',
      'Sustain continuous fire while flying to execute aerial strafing runs across enemy convoys.'
    ]
  },
  {
    id: 'cryo',
    code: '02',
    title: 'Cryo Freeze Ray',
    category: 'Sub-Zero Crowd Control',
    image: '/images/cryo-freeze.jpg',
    imageAlt: 'OverPeak Cryo Freeze Ray freezing heavy mechs and drones in combat',
    stats: { damage: '65 / 100', range: '75 meters', consumption: 'High / sec', cooldown: '3.0 sec' },
    summary: 'Emits an endothermic thermal wave that drops ambient temperatures to absolute zero within fractions of a second. Immobilizes heavy combat mechs and freezes fleeing targets into brittle ice statues.',
    tips: [
      'Frozen enemies suffer increased damage from subsequent kinetic attacks or thrown objects.',
      'Freeze low-altitude attack choppers to stall their rotors, sending them spiraling into skyscrapers.',
      'Deploy when surrounded by tactical SWAT squads to create safe breathing room.'
    ]
  },
  {
    id: 'kinetic',
    code: '03',
    title: 'Telekinetic Force Grip',
    category: 'Physics Mass Manipulation',
    image: '/images/telekinesis.jpg',
    imageAlt: 'OverPeak Telekinetic Force Grip hurling vehicles and debris across city avenues',
    stats: { damage: 'Mass-Based', range: '50 meters', consumption: 'Low / throw', cooldown: '1.5 sec' },
    summary: 'Harnesses gravitational anomalies to levitate massive physical objects in the environment—from police cruisers and construction I-beams to giant slabs of fallen skyscraper masonry—and violently hurl them across city blocks.',
    tips: [
      'Heavier objects deal exponentially higher impact force and create wider debris shockwaves.',
      'Rip structural support beams directly out of building walls to cause spontaneous collapse.',
      'Catch incoming enemy artillery shells and rockets in mid-air to redirect at the firing turret.'
    ]
  },
  {
    id: 'flight',
    code: '04',
    title: 'Sonic Flight & Air Dash',
    category: '3D Omnidirectional Traversal',
    image: '/images/hero-banner.jpg',
    imageAlt: 'OverPeak Sonic Flight above Prism City',
    stats: { damage: '75 / 100', range: 'Unlimited', consumption: 'Passive Drain', cooldown: 'Instant' },
    summary: 'Bypasses Earth gravity through bio-magnetic propulsion. Subject OP can effortlessly hover at rooftop altitude, achieve Mach 2 supersonic sprint velocity, and create shockwave sonic booms that shatter surrounding storefront windows.',
    tips: [
      'Double-tap the Dash button mid-flight to perform an invulnerable 360-degree dodge roll.',
      'Combine flight with downward dive to build extreme kinetic velocity for ground-pound slams.',
      'Provides total tactical superiority by evading ground-based barricades and minefields.'
    ]
  },
  {
    id: 'slam',
    code: '05',
    title: 'Cataclysmic Ground Slam',
    category: 'Seismic Shockwave Devastation',
    image: '/images/telekinesis.jpg',
    imageAlt: 'OverPeak Cataclysmic Ground Slam',
    stats: { damage: '100 / 100', range: '35m Radius', consumption: '100% Burst', cooldown: '15.0 sec' },
    summary: 'Executing a terminal velocity dive from high altitude, Subject OP channels all kinetic potential into a single catastrophic fist-strike upon impact. Creates a 35-meter radial crater that triggers subterranean tremors and destabilizes nearby architectural foundations.',
    tips: [
      'The higher your starting altitude before initiating the dive, the wider the devastation crater.',
      'Instantly obliterates all light vehicles and infantry units within the primary blast ring.',
      'Causes adjacent buildings with pre-existing laser damage to immediately experience fatal collapse.'
    ]
  }
];
---

<Layout title={pageTitle} description={pageDescription} schema={powersSchema}>

  <!-- Clean Page Header (Matching Homepage Style) -->
  <section class="border-b border-op-border bg-gradient-to-b from-op-darkest via-op-dark to-op-darkest py-10 sm:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="font-mono text-xs text-slate-400 mb-4 flex items-center gap-2">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-white">Superpowers &amp; Destruction Guide</span>
      </nav>

      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-op-card border border-op-border text-[11px] font-mono text-slate-300 uppercase tracking-wider mb-4">
          <span class="w-2 h-2 rounded-full bg-op-green"></span>
          <span>Subject OP Combat Arsenal</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black text-white font-display uppercase tracking-tight mb-3">
          OverPeak Superpowers &amp; Physics Guide
        </h1>

        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          Master the genetic abilities of Jason Fieldway (Subject OP). Explore damage ratings, energy consumption profiles, and proprietary architectural demolition techniques in Prism City.
        </p>
      </div>

    </div>
  </section>

  <!-- Superpower Cards Detail List (Clean, Uniform Gaming Cards) -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    {abilities.map((ability) => (
      <div id={ability.id} class="p-6 sm:p-8 rounded-2xl bg-op-card border border-op-border hover:border-slate-500 transition-all shadow-lg">
        
        <!-- Header Row -->
        <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-6 mb-6">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-op-dark border border-op-border flex items-center justify-center font-mono font-black text-sm text-slate-300 flex-shrink-0">
              {ability.code}
            </div>
            <div>
              <h2 class="text-2xl font-black text-white font-display uppercase tracking-tight mb-1">
                {ability.title}
              </h2>
              <p class="font-mono text-xs text-slate-400 uppercase tracking-wider">{ability.category}</p>
            </div>
          </div>

          <!-- Quick Stats Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 font-mono text-xs">
            <div class="p-3 rounded-xl bg-op-dark border border-op-border">
              <span class="text-[10px] text-slate-400 block uppercase mb-0.5">Damage</span>
              <span class="text-white font-bold">{ability.stats.damage}</span>
            </div>
            <div class="p-3 rounded-xl bg-op-dark border border-op-border">
              <span class="text-[10px] text-slate-400 block uppercase mb-0.5">Range</span>
              <span class="text-white font-bold">{ability.stats.range}</span>
            </div>
            <div class="p-3 rounded-xl bg-op-dark border border-op-border">
              <span class="text-[10px] text-slate-400 block uppercase mb-0.5">Energy</span>
              <span class="text-white font-bold">{ability.stats.consumption}</span>
            </div>
            <div class="p-3 rounded-xl bg-op-dark border border-op-border">
              <span class="text-[10px] text-slate-400 block uppercase mb-0.5">Cooldown</span>
              <span class="text-white font-bold">{ability.stats.cooldown}</span>
            </div>
          </div>
        </div>

        <p class="text-slate-300 text-sm leading-relaxed mb-6">
          {ability.summary}
        </p>

        <!-- Gameplay Visual Capture Frame -->
        {ability.image && (
          <div class="mb-6 rounded-2xl overflow-hidden border border-op-border shadow-lg relative group">
            <img
              src={ability.image}
              alt={ability.imageAlt}
              width="1024"
              height="576"
              class="w-full h-64 sm:h-80 object-cover object-center transform group-hover:scale-102 transition-transform duration-700"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-op-darkest/95 via-transparent to-transparent"></div>
            <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between font-mono text-xs">
              <div class="bg-black/85 backdrop-blur-md px-3.5 py-1.5 rounded-lg border border-white/10 text-white flex items-center gap-2">
                <span>In-Engine Capture</span>
                <span class="text-slate-400">• {ability.title}</span>
              </div>
              <span class="hidden sm:inline-block px-2.5 py-1 rounded bg-white/10 border border-white/10 text-slate-300 text-[10px] uppercase font-bold">
                Voxel Physics
              </span>
            </div>
          </div>
        )}

        <!-- Tactical Directives -->
        <div class="p-5 rounded-xl bg-op-dark border border-op-border">
          <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-300 mb-3">
            Combat Directives &amp; Synergy
          </h3>
          <ul class="space-y-2 text-xs sm:text-sm text-slate-300">
            {ability.tips.map((tip) => (
              <li class="flex items-start gap-2.5">
                <span class="text-slate-500 font-mono mt-0.5">•</span>
                <span>{tip}</span>
              </li>
            ))}
          </ul>
        </div>

      </div>
    ))}
  </section>

  <!-- Skyscraper Demolition Physics Engine Section -->
  <section id="destruction" class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-op-border">
    <div class="mb-8">
      <h2 class="text-2xl font-black text-white font-display uppercase tracking-tight mb-2">
        Building Destruction Physics
      </h2>
      <p class="text-slate-300 text-xs sm:text-sm leading-relaxed max-w-3xl">
        OverPeak calculates real-time stress distribution across architectural columns, crossbeams, and facade slabs rather than playing pre-baked scripted destruction animations.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <div class="p-6 rounded-2xl bg-op-card border border-op-border">
        <div class="w-8 h-8 rounded-lg bg-op-dark border border-op-border text-white font-mono font-bold flex items-center justify-center mb-3 text-xs">
          01
        </div>
        <h3 class="text-white font-bold text-sm mb-2 font-display">1. Column Severance</h3>
        <p class="text-slate-300 text-xs leading-relaxed">
          Use <strong>Thermal Laser Vision</strong> or <strong>Telekinesis</strong> to destroy the 4 ground-floor corner columns. When structural integrity drops below 25%, gravity takes over.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-op-card border border-op-border">
        <div class="w-8 h-8 rounded-lg bg-op-dark border border-op-border text-white font-mono font-bold flex items-center justify-center mb-3 text-xs">
          02
        </div>
        <h3 class="text-white font-bold text-sm mb-2 font-display">2. Dynamic Weight Shift</h3>
        <p class="text-slate-300 text-xs leading-relaxed">
          The skyscraper visibly tilts in real-time toward the weakened axis. Secondary explosions occur as electrical grids, elevators, and gas pipelines rupture inside the building.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-op-card border border-op-border">
        <div class="w-8 h-8 rounded-lg bg-op-dark border border-op-border text-white font-mono font-bold flex items-center justify-center mb-3 text-xs">
          03
        </div>
        <h3 class="text-white font-bold text-sm mb-2 font-display">3. Catastrophic Collapse</h3>
        <p class="text-slate-300 text-xs leading-relaxed">
          Tens of thousands of physics debris chunks crush enemy vehicles and barricades below, generating dust shockwaves across surrounding city avenues.
        </p>
      </div>

    </div>
  </section>

</Layout>
