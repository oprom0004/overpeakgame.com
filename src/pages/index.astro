---
import Layout from '../layouts/Layout.astro';

const pageTitle = 'OverPeak: Action Game – Official Guide, Download & PC Setup';
const pageDescription = 'Official database and gameplay guide for OverPeak: Action Game by R-USER Games. Explore Subject OP superpowers, Prism City destruction physics, offline mode, and 120 FPS PC setup.';

const homeSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "name": "OverPeak Game Database",
      "url": "https://overpeakgame.com/"
    },
    {
      "@type": "VideoGame",
      "name": "OverPeak: Action Game",
      "applicationCategory": "Game",
      "operatingSystem": "Android, Windows (via Emulator), iOS (Coming Soon)",
      "author": {
        "@type": "Organization",
        "name": "R-USER Games"
      },
      "datePublished": "2026-09-27",
      "genre": ["Action", "Open World", "Superhero", "Physics Sandbox"],
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.2",
        "ratingCount": "8253",
        "reviewCount": "8253",
        "bestRating": "5"
      },
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock"
      }
    }
  ]
};

const powers = [
  {
    tag: 'ENERGY',
    num: '01',
    name: 'Thermal Laser Vision',
    type: 'Offensive Ranged',
    border: 'border-op-laser/40 text-op-laser',
    desc: 'Focus high-energy thermal beams to slice armored transport vehicles, incinerate Starbridge shock troops, and weaken concrete structural supports.',
  },
  {
    tag: 'CRYO',
    num: '02',
    name: 'Cryo Freeze Ray',
    type: 'Crowd Control',
    border: 'border-op-cryo/40 text-op-cryo',
    desc: 'Flash-freeze enemy security drones and fleeing suspects into solid ice before shattering them with kinetic force.',
  },
  {
    tag: 'KINETIC',
    num: '03',
    name: 'Telekinetic Force Push',
    type: 'Physics Manipulation',
    border: 'border-op-kinetic/40 text-op-kinetic',
    desc: 'Levitate sedans, concrete barricades, and steel girders to hurl across Prism City streets with devastating pinpoint momentum.',
  },
  {
    tag: 'TRAVERSAL',
    num: '04',
    name: 'Sonic Flight & Ground Slam',
    type: 'Mobility & Area of Effect',
    border: 'border-op-gold/40 text-op-gold',
    desc: 'Break the sound barrier soaring above skyscrapers, then execute a catastrophic supersonic ground slam that topples nearby structures.',
  },
];
---

<Layout title={pageTitle} description={pageDescription} schema={homeSchema}>
  
  <!-- Hero Section (Professional Game Portal / Steam Store Layout) -->
  <section class="border-b border-op-border bg-gradient-to-b from-op-darkest via-op-dark to-op-darkest py-10 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        
        <!-- Left Column: Title, Editorial Hook, Download Badges & Steam-Style Specs Matrix -->
        <div class="lg:col-span-6 space-y-6">
          
          <div>
            <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-op-card border border-op-border text-[11px] font-mono text-slate-300 uppercase tracking-wider mb-4">
              <span class="w-2 h-2 rounded-full bg-op-green"></span>
              <span>R-USER Games • Third-Person Action RPG</span>
            </div>

            <h1 class="text-3xl sm:text-5xl font-black text-white font-display uppercase tracking-tight leading-none mb-4">
              OverPeak: Action Game
            </h1>

            <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
              Step into the role of <strong>Jason Fieldway (Subject OP)</strong>, a genetically modified survivor awakened for retribution against Starbridge Corporation. Topple skyscrapers through unscripted voxel destruction physics, fly at supersonic speeds across Prism City, and decide whether the metropolis fears you as a savior or a villain.
            </p>
          </div>

          <!-- Official Store & Setup Action Links -->
          <div class="flex flex-wrap items-center gap-3 pt-1">
            
            <!-- Official Google Play Badge (Authentic Storefront Button) -->
            <a
              href="/download/#android"
              class="inline-flex items-center gap-3 px-4 py-2.5 rounded-xl bg-black border border-white/20 hover:border-white/50 text-white transition-all shadow-md group"
            >
              <svg class="w-6 h-6 flex-shrink-0" viewBox="0 0 24 24" fill="none">
                <path d="M3.6 1.7L13.7 12 3.6 22.3c-.4-.3-.6-.8-.6-1.4V3.1c0-.6.2-1.1.6-1.4z" fill="#00E5FF"/>
                <path d="M17.1 8.6L13.7 12l3.4 3.4 3.9-2.2c1.1-.6 1.1-1.7 0-2.4l-3.9-2.2z" fill="#FFD600"/>
                <path d="M3.6 1.7l10.1 10.3 3.4-3.4L6.2.7C5.1.1 4.1.4 3.6 1.7z" fill="#00E676"/>
                <path d="M3.6 22.3l13.5-7.7-3.4-3.4L3.6 22.3z" fill="#FF3D00"/>
              </svg>
              <div class="text-left font-sans">
                <div class="text-[9px] text-slate-400 uppercase tracking-wider font-mono">Get it on</div>
                <div class="text-xs font-bold leading-tight">Google Play</div>
              </div>
            </a>

            <!-- PC Setup Guide Link -->
            <a
              href="/pc/"
              class="inline-flex items-center gap-2 px-4 py-3 rounded-xl bg-op-card border border-op-border hover:border-slate-400 text-slate-200 hover:text-white font-mono text-xs uppercase font-semibold transition-all"
            >
              <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <rect x="2" y="3" width="20" height="14" rx="2" stroke-width="2"/>
                <line x1="8" y1="21" x2="16" y2="21" stroke-width="2"/>
                <line x1="12" y1="17" x2="12" y2="21" stroke-width="2"/>
              </svg>
              <span>PC 120 FPS Setup</span>
            </a>

            <!-- Powers Wiki Link -->
            <a
              href="/powers/"
              class="inline-flex items-center gap-2 px-4 py-3 rounded-xl bg-op-card border border-op-border hover:border-slate-400 text-slate-200 hover:text-white font-mono text-xs uppercase font-semibold transition-all"
            >
              <span>Abilities Wiki</span>
              <span>→</span>
            </a>

          </div>

          <!-- Steam-Style Compact Specs Matrix (Authentic Gaming Meta Box) -->
          <div class="rounded-xl bg-op-card/90 border border-op-border p-4 font-mono text-xs space-y-2.5">
            <div class="flex items-center justify-between pb-2 border-b border-op-border/60">
              <span class="text-slate-400">DEVELOPER</span>
              <span class="text-white font-bold">R-USER Games</span>
            </div>
            <div class="flex items-center justify-between pb-2 border-b border-op-border/60">
              <span class="text-slate-400">INITIAL RELEASE</span>
              <span class="text-white font-bold">Sept 27, 2026 (v0.6 Early Access)</span>
            </div>
            <div class="flex items-center justify-between pb-2 border-b border-op-border/60">
              <span class="text-slate-400">SUPPORTED PLATFORMS</span>
              <span class="text-white font-bold">Android • PC (via 64-bit Emulator)</span>
            </div>
            <div class="flex items-center justify-between pb-2 border-b border-op-border/60">
              <span class="text-slate-400">GAMEPLAY MODE</span>
              <span class="text-white font-bold">100% Offline Single-Player</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-400">STORE SCORE</span>
              <span class="text-white font-bold">★ 4.2 / 5.0 (8,250+ Google Play Ratings)</span>
            </div>
          </div>

        </div>

        <!-- Right Column: 16:9 Gameplay Key Visual & Interactive Screenshot Previews -->
        <div class="lg:col-span-6 space-y-3">
          
          <div class="rounded-2xl overflow-hidden border border-op-border bg-op-dark shadow-2xl relative group">
            <img
              src="/images/hero-banner.jpg"
              alt="OverPeak Gameplay: Subject OP flying with Thermal Laser Vision destroying Prism City skyscraper"
              width="1280"
              height="720"
              class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
            <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between font-mono text-xs text-white">
              <span class="font-bold">PRISM CITY // UNREAL VOXEL DEMOLITION</span>
              <span class="text-op-green text-[11px]">● In-Engine Capture</span>
            </div>
          </div>

          <!-- Screenshot Gallery Navigation Tabs (Steam Store Style) -->
          <div class="grid grid-cols-3 gap-3">
            <a href="/powers/#cryo" class="rounded-xl overflow-hidden border border-op-border bg-op-card p-1.5 hover:border-op-cryo transition-all group">
              <div class="aspect-video rounded-lg overflow-hidden mb-1.5">
                <img src="/images/cryo-freeze.jpg" alt="Cryo Freeze Ray Gameplay" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300" />
              </div>
              <div class="font-mono text-[10px] text-slate-300 group-hover:text-white truncate">Cryo Freeze Combat</div>
            </a>

            <a href="/powers/#kinetic" class="rounded-xl overflow-hidden border border-op-border bg-op-card p-1.5 hover:border-op-kinetic transition-all group">
              <div class="aspect-video rounded-lg overflow-hidden mb-1.5">
                <img src="/images/telekinesis.jpg" alt="Telekinetic Force Push" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300" />
              </div>
              <div class="font-mono text-[10px] text-slate-300 group-hover:text-white truncate">Telekinetic Physics</div>
            </a>

            <a href="/pc/" class="rounded-xl overflow-hidden border border-op-border bg-op-card p-1.5 hover:border-op-gold transition-all group">
              <div class="aspect-video rounded-lg overflow-hidden mb-1.5">
                <img src="/images/pc-setup.jpg" alt="PC 120 FPS Battlestation" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300" />
              </div>
              <div class="font-mono text-[10px] text-slate-300 group-hover:text-white truncate">PC 120 FPS Setup</div>
            </a>
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- Editorial Executive Brief / Game Dossier (Authentic Game Wiki Overview, Optimized for AI Parsing) -->
  <section class="py-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="p-6 sm:p-8 rounded-2xl bg-op-card border border-op-border">
      <div class="flex items-center gap-2 mb-3">
        <span class="px-2 py-0.5 rounded bg-op-dark border border-op-border font-mono text-[11px] text-slate-300 uppercase tracking-wider">
          TACTICAL DOSSIER // GAME OVERVIEW
        </span>
      </div>
      <h2 class="text-xl sm:text-2xl font-black text-white font-display mb-3">
        About OverPeak: Action Game
      </h2>
      <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-4">
        <strong>OverPeak</strong> is a third-person superhero action RPG developed and published by <strong>R-USER Games</strong>, officially released on Android via the Google Play Store on September 27, 2026. Players control <strong>Jason Fieldway (Subject OP)</strong>, an experimental bio-weapon seeking retribution against the Starbridge Corporation across the dystopian metropolis of Prism City. The game features real-time building destruction physics, five core superpower disciplines (thermal lasers, sub-zero freeze rays, telekinesis, supersonic flight, and seismic ground slams), complete offline solo play capability, and dynamic hero-versus-villain reputation paths.
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 font-mono text-xs pt-3 border-t border-op-border/50 text-slate-400">
        <div><strong class="text-slate-200">Developer:</strong> R-USER Games</div>
        <div><strong class="text-slate-200">Package:</strong> com.rusergames.overpeak</div>
        <div><strong class="text-slate-200">Engine:</strong> Unity 3D (Voxel)</div>
        <div><strong class="text-slate-200">Offline Play:</strong> 100% Verified</div>
      </div>
    </div>
  </section>

  <!-- Section 1: Gameplay Showcase & Destruction Mechanics -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-op-border">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      
      <div>
        <div class="inline-block px-2.5 py-1 rounded bg-op-card border border-op-border text-slate-300 font-mono text-xs uppercase mb-4">
          PRISM CITY OPEN-WORLD
        </div>
        <h2 class="text-2xl sm:text-4xl font-black text-white font-display uppercase tracking-tight mb-4">
          A Living Metropolis Engineered for Dynamic Demolition
        </h2>
        <p class="text-slate-300 leading-relaxed text-sm mb-4">
          Unlike static mobile action sandboxes, <strong>OverPeak</strong> features a proprietary dynamic destruction mesh. Fire lasers at architectural support pillars, and witness real-time structural stress cause entire multi-story complexes to crumble onto the boulevard below.
        </p>
        <p class="text-slate-300 leading-relaxed text-sm mb-6">
          As <strong>Subject OP</strong>, your genetic modifications grant unprecedented mobility. Seamlessly transition from high-velocity pedestrian sprinting to vertical wall-runs, hypersonic air dashes, and full 360-degree freeflight above the city smog.
        </p>

        <!-- Feature List -->
        <div class="space-y-2.5 font-mono text-xs text-slate-300">
          <div class="flex items-center gap-2">
            <span class="text-slate-500 font-bold">›</span>
            <span>Full Ragdoll &amp; Dynamic Fracture Physics</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-slate-500 font-bold">›</span>
            <span>Multi-Tier Reputation System (Civilian Ally vs Dreaded Enforcer)</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-slate-500 font-bold">›</span>
            <span>Starbridge Tactical Drones &amp; Heavy Mechs Escalation</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-slate-500 font-bold">›</span>
            <span>Playable Offline (No mandatory internet connection required)</span>
          </div>
        </div>
      </div>

      <!-- Visual Gameplay Image Showcase Card -->
      <div class="rounded-2xl bg-op-card border border-op-border p-3 shadow-2xl relative overflow-hidden group">
        <div class="aspect-video w-full rounded-xl overflow-hidden relative">
          <img
            src="/images/telekinesis.jpg"
            alt="OverPeak Telekinetic power: Throwing sedans and concrete in Prism City street"
            width="1280"
            height="720"
            class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
          <div class="absolute bottom-3 left-3 right-3 flex justify-between items-center text-xs font-mono">
            <span class="px-2 py-0.5 rounded bg-op-dark border border-op-border text-white text-[10px] uppercase font-bold">
              Telekinesis Physics
            </span>
            <span class="text-slate-400 bg-black/60 px-2 py-0.5 rounded">60 FPS Action</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Section 2: Superpowers Matrix -->
  <section class="py-12 border-t border-op-border bg-op-dark/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-2xl mb-8">
        <div class="inline-block px-2.5 py-1 rounded bg-op-card border border-op-border text-slate-300 font-mono text-xs uppercase mb-3">
          GENETIC ARSENAL
        </div>
        <h2 class="text-2xl sm:text-4xl font-black text-white font-display uppercase tracking-tight mb-2">
          Master the Five Genetic Superpowers
        </h2>
        <p class="text-slate-400 text-xs sm:text-sm">
          Customize your loadout to dominate both aerial combat drones and ground-level armored convoys.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {powers.map((power) => (
          <div class="p-6 rounded-2xl bg-op-card border border-op-border hover:border-white/20 transition-all">
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-[11px] font-bold px-2 py-0.5 rounded bg-op-dark border border-white/10 text-slate-300">
                [{power.tag}]
              </span>
              <span class="font-mono text-xs text-slate-500 font-bold">{power.num}</span>
            </div>
            <div class="font-mono text-[11px] text-slate-400 uppercase mb-1">{power.type}</div>
            <h3 class="text-lg font-bold text-white mb-2">{power.name}</h3>
            <p class="text-xs text-slate-300 leading-relaxed mb-4">{power.desc}</p>
            <a href="/powers/" class="font-mono text-xs text-white font-semibold hover:underline flex items-center gap-1">
              <span>Read Ability Mechanics</span>
              <span>→</span>
            </a>
          </div>
        ))}
      </div>

      <div class="mt-8 text-center">
        <a
          href="/powers/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-op-card border border-op-border text-white font-mono text-xs uppercase font-bold hover:border-white/40 transition-all"
        >
          <span>View Complete Superpowers Tier List &amp; Demolition Guide →</span>
        </a>
      </div>

    </div>
  </section>

  <!-- Section 3: Platform & Download Quick Access -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-op-border">
    <div class="p-8 rounded-2xl bg-op-card border border-op-border">
      <div class="max-w-3xl">
        <div class="inline-block px-2.5 py-1 rounded bg-op-dark border border-op-border text-slate-400 font-mono text-xs uppercase mb-3">
          PLATFORMS &amp; DISTRIBUTION
        </div>
        <h2 class="text-2xl sm:text-3xl font-black text-white font-display uppercase tracking-tight mb-3">
          Verified Installation Channels
        </h2>
        <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-6">
          OverPeak is currently live on <strong>Android via Google Play</strong>. Apple iOS players can track official App Store review status, and desktop users can configure 60–120 FPS high-refresh emulation with customized keybinds.
        </p>

        <div class="flex flex-wrap gap-4 font-mono text-xs">
          <a
            href="/download/#android"
            class="px-4 py-2.5 rounded-lg bg-op-dark border border-op-border text-white hover:border-white/40 transition-all flex items-center gap-2"
          >
            <span class="w-2 h-2 rounded-full bg-white/40"></span>
            <span>Android (Google Play)</span>
          </a>
          <a
            href="/download/#ios"
            class="px-4 py-2.5 rounded-lg bg-op-dark border border-op-border text-slate-400 hover:text-white transition-all flex items-center gap-2"
          >
            <span class="w-2 h-2 rounded-full bg-white/40"></span>
            <span>iOS App Store Status</span>
          </a>
          <a
            href="/pc/"
            class="px-4 py-2.5 rounded-lg bg-op-dark border border-op-border text-white hover:border-white/40 transition-all flex items-center gap-2"
          >
            <span>PC 120 FPS Setup Guide</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>
