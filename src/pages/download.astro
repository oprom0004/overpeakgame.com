---
import Layout from '../layouts/Layout.astro';

const pageTitle = 'Download OverPeak: Action Game – Android Google Play, PC & iOS Portals';
const pageDescription = 'Official verified download portal for OverPeak: Action Game by R-USER Games. Access the Google Play Store build, PC 120 FPS emulator setup, iOS availability tracker, and full hardware requirements.';

const downloadSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://overpeakgame.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Download",
          "item": "https://overpeakgame.com/download/"
        }
      ]
    },
    {
      "@type": "SoftwareApplication",
      "name": "OverPeak: Action Game",
      "operatingSystem": "Android 9.0+, Windows 10/11 (via 64-bit Emulator)",
      "applicationCategory": "GameApplication",
      "downloadUrl": "https://play.google.com/store/apps/details?id=com.rusergames.overpeak&hl=en",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is OverPeak: Action Game completely free to play?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, OverPeak is 100% free to download and play from the official Google Play Store with no mandatory paywalls to complete the storyline."
          }
        },
        {
          "@type": "Question",
          "name": "Can OverPeak be played offline without WiFi or mobile data?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, once downloaded and installed, all open-world sandbox mechanics, real-time building destruction physics, and story missions run completely offline on your device."
          }
        },
        {
          "@type": "Question",
          "name": "Are OverPeak Mod APK downloads with unlimited money safe?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Modified APK files from unauthorized third-party sites frequently bundle trojans, adware, and spyware. We strongly advise playing only the verified Google Play Store build."
          }
        },
        {
          "@type": "Question",
          "name": "Can I play OverPeak on PC with keyboard and mouse?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. While R-USER Games develops a native PC build, players can enjoy OverPeak immediately at 60–120 FPS using 64-bit Android emulators like MuMuPlayer 12 or BlueStacks 5 with custom WASD and mouse aiming controls."
          }
        }
      ]
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} schema={downloadSchema}>

  <!-- Atmospheric Hero Header with Deep Lighting -->
  <section class="relative border-b border-op-border bg-op-darkest overflow-hidden py-14 sm:py-16">
    <!-- Ambient Energy Radial Lighting -->
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[800px] h-[350px] bg-gradient-to-b from-orange-500/15 via-amber-500/5 to-transparent blur-3xl pointer-events-none"></div>
    <div class="absolute inset-0 opacity-15 bg-cover bg-center pointer-events-none" style="background-image: url('/images/hero-banner.jpg');"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-op-darkest via-op-darkest/90 to-transparent"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Tactical Breadcrumb -->
      <nav class="font-mono text-xs text-slate-400 mb-6 flex items-center gap-2">
        <a href="/" class="hover:text-white transition-colors flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-slate-500" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" />
          </svg>
          <span>Home</span>
        </a>
        <span class="text-slate-600">/</span>
        <span class="text-white font-medium">Download &amp; Platforms</span>
      </nav>

      <!-- Hero Content Row -->
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8">
        <div class="flex items-start gap-5 sm:gap-6">
          <div class="relative w-20 h-20 sm:w-24 sm:h-24 rounded-2xl bg-op-card border-2 border-orange-500/40 p-1 flex-shrink-0 shadow-[0_0_25px_rgba(249,115,22,0.25)]">
            <img src="/images/hero-banner.jpg" alt="OverPeak App Icon" class="w-full h-full object-cover rounded-xl" />
            <div class="absolute -bottom-2 -right-2 px-2 py-0.5 rounded-full bg-emerald-500/90 text-white font-mono text-[10px] font-black uppercase shadow tracking-wider">
              Live
            </div>
          </div>

          <div>
            <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-orange-500/10 border border-orange-500/30 text-xs font-mono text-orange-300 mb-2.5">
              <span class="w-1.5 h-1.5 rounded-full bg-orange-400 animate-pulse"></span>
              <span class="font-bold tracking-wide">VERIFIED OFFICIAL CLIENT</span>
              <span class="text-slate-500">|</span>
              <span class="text-slate-300">Version 0.6 Early Access</span>
            </div>

            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white font-display uppercase tracking-tight">
              Download OverPeak: Action Game
            </h1>

            <p class="text-slate-300 text-xs sm:text-sm mt-2 flex flex-wrap items-center gap-x-3 gap-y-1">
              <span class="font-semibold text-white">R-USER Games</span>
              <span class="text-slate-600">•</span>
              <span>Open-World Superhero Sandbox</span>
              <span class="text-slate-600">•</span>
              <span class="text-amber-400 font-bold flex items-center gap-1">
                <span>★ 4.2</span>
                <span class="text-slate-400 font-normal text-xs">(8,250+ Ratings)</span>
              </span>
              <span class="text-slate-600">•</span>
              <span class="text-emerald-400 font-mono text-xs">100% Offline Capable</span>
            </p>
          </div>
        </div>

        <!-- Quick Jump Links -->
        <div class="flex items-center flex-wrap gap-3 font-mono text-xs">
          <a
            href="https://play.google.com/store/apps/details?id=com.rusergames.overpeak&hl=en"
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-3 rounded-xl bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-600 hover:to-amber-600 text-white font-bold uppercase tracking-wider transition-all shadow-[0_4px_20px_rgba(249,115,22,0.35)] flex items-center gap-2"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3.609 1.814L13.793 12 3.61 22.186c-.328-.352-.51-.83-.51-1.386V3.2c0-.556.182-1.034.51-1.386zM15.207 13.414l2.428-2.428-2.428-2.428 1.414-1.414 3.842 3.842-3.842 3.842-1.414-1.414zM4.686 23.262l10.02-10.02 2.152 2.152-10.74 6.2c-.44.254-.954.218-1.432-.082v1.75zM4.686.738l10.74 6.2-2.152 2.152-10.02-10.02c.478-.3 1-.336 1.432-.082z" />
            </svg>
            <span>Google Play Store</span>
            <span class="text-white/80">↗</span>
          </a>

          <a
            href="#pc-platform"
            class="px-4 py-3 rounded-xl bg-op-card border border-op-border hover:border-slate-500 text-slate-200 hover:text-white font-bold uppercase tracking-wider transition-colors flex items-center gap-2"
          >
            <span>PC 120 FPS Setup</span>
            <span class="text-slate-500">↓</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- Editorial Distribution Security Advisory Box -->
  <section class="py-8 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="p-6 sm:p-7 rounded-2xl bg-gradient-to-r from-op-card via-op-card to-op-dark border border-op-border relative overflow-hidden shadow-xl">
      <!-- Glow Accent Line -->
      <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-orange-500 via-amber-400 to-transparent"></div>
      
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 mb-3">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-orange-500/10 border border-orange-500/30 flex items-center justify-center text-orange-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <div>
            <span class="font-mono text-[11px] text-orange-400 font-bold uppercase tracking-wider block">
              OFFICIAL VERIFICATION // SECURITY NOTICE
            </span>
            <h2 class="text-lg sm:text-xl font-black text-white font-display">
              Where to Safely Download OverPeak
            </h2>
          </div>
        </div>

        <div class="flex items-center gap-3 font-mono text-xs">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 font-semibold">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            Google Play Protect Certified
          </span>
          <span class="text-slate-500 hidden sm:inline">•</span>
          <span class="text-slate-400 hidden sm:inline">SHA-256 Verified Clean</span>
        </div>
      </div>

      <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-4">
        <strong>OverPeak: Action Game</strong> is officially distributed exclusively on Android via the <strong>Google Play Store</strong> (Package: <code class="px-1.5 py-0.5 rounded bg-op-dark border border-op-border text-orange-300 font-mono text-xs">com.rusergames.overpeak</code>, published by R-USER Games). We strongly advise avoiding third-party <em>"Mod APK Unlimited Money"</em> or pirated mirror sites; unauthorized installers frequently tamper with native binaries to inject background adware, battery miners, and credential stealers.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-3 border-t border-op-border/60 font-mono text-xs text-slate-300">
        <div class="flex items-center gap-2">
          <span class="text-slate-500">Official Package:</span>
          <span class="text-white font-semibold">com.rusergames.overpeak</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-slate-500">Current Build:</span>
          <span class="text-emerald-400 font-bold">0.6 Early Access</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="text-slate-500">Data Architecture:</span>
          <span class="text-white">100% Offline Local Saves</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Platform Cards Grid (High-End 3A Game Client Style) -->
  <section class="py-8 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-8">
      <div>
        <div class="font-mono text-xs text-orange-400 font-bold uppercase tracking-wider mb-1">
          PLATFORM DEPLOYMENT MATRIX
        </div>
        <h2 class="text-2xl sm:text-3xl font-black text-white font-display uppercase tracking-tight">
          Select Your Gaming Client
        </h2>
      </div>
      <p class="font-mono text-xs text-slate-400">
        Cross-platform availability &amp; hardware performance tiers
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Card 1: Android Google Play (Active Live Tier) -->
      <div id="android" class="relative rounded-2xl bg-gradient-to-b from-op-card via-op-card to-op-dark border-2 border-orange-500/50 hover:border-orange-400 transition-all duration-300 flex flex-col justify-between shadow-[0_10px_35px_rgba(249,115,22,0.15)] group overflow-hidden">
        <!-- Top Radiant Glow Strip -->
        <div class="h-1.5 w-full bg-gradient-to-r from-orange-500 via-amber-400 to-orange-600"></div>

        <div class="p-6 sm:p-7 flex-grow">
          <!-- Card Header & Badge -->
          <div class="flex items-center justify-between mb-4">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-orange-500/15 border border-orange-500/40 font-mono text-[11px] text-orange-300 uppercase font-black tracking-wide">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Android • Live Storefront
            </span>
            <div class="flex items-center gap-1 font-mono text-xs font-bold text-amber-400 bg-black/40 px-2 py-0.5 rounded border border-white/10">
              <span>★ 4.2</span>
              <span class="text-slate-400 font-normal text-[10px]">(8.2k)</span>
            </div>
          </div>

          <h3 class="text-2xl font-black text-white font-display mb-2 group-hover:text-orange-300 transition-colors">
            Google Play Store
          </h3>

          <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-6">
            The official release published directly by <strong>R-USER Games</strong>. Includes unscripted voxel building destruction, open-world missions, touch optimization, and seamless offline play.
          </p>

          <!-- Spec Matrix Pills -->
          <div class="space-y-2.5 font-mono text-xs mb-8 bg-op-dark/60 p-4 rounded-xl border border-op-border">
            <div class="flex items-center justify-between pb-2 border-b border-op-border/50">
              <span class="text-slate-400">Package Identifier:</span>
              <span class="text-white font-bold">com.rusergames.overpeak</span>
            </div>
            <div class="flex items-center justify-between pb-2 border-b border-op-border/50">
              <span class="text-slate-400">Target Android Version:</span>
              <span class="text-white font-bold">Android 9.0 (Pie) or higher</span>
            </div>
            <div class="flex items-center justify-between pb-2 border-b border-op-border/50">
              <span class="text-slate-400">App Download Size:</span>
              <span class="text-orange-300 font-bold">~1.2 GB Storage</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-400">Offline Functionality:</span>
              <span class="text-emerald-400 font-bold">100% Offline Capable</span>
            </div>
          </div>
        </div>

        <!-- Action Button Section -->
        <div class="p-6 sm:p-7 pt-0">
          <a
            href="https://play.google.com/store/apps/details?id=com.rusergames.overpeak&hl=en"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-600 hover:to-amber-600 text-white font-mono font-black text-xs uppercase tracking-wider text-center block shadow-[0_4px_16px_rgba(249,115,22,0.3)] transition-all flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M3.609 1.814L13.793 12 3.61 22.186c-.328-.352-.51-.83-.51-1.386V3.2c0-.556.182-1.034.51-1.386zM15.207 13.414l2.428-2.428-2.428-2.428 1.414-1.414 3.842 3.842-3.842 3.842-1.414-1.414zM4.686 23.262l10.02-10.02 2.152 2.152-10.74 6.2c-.44.254-.954.218-1.432-.082v1.75zM4.686.738l10.74 6.2-2.152 2.152-10.02-10.02c.478-.3 1-.336 1.432-.082z" />
            </svg>
            <span>Get on Google Play (Direct) ↗</span>
          </a>
        </div>
      </div>

      <!-- Card 2: Desktop PC Emulation (High Performance 120 FPS) -->
      <div id="pc-platform" class="relative rounded-2xl bg-gradient-to-b from-op-card via-op-card to-op-dark border border-cyan-500/40 hover:border-cyan-400 transition-all duration-300 flex flex-col justify-between shadow-[0_10px_35px_rgba(6,182,212,0.12)] group overflow-hidden">
        <!-- Top Radiant Glow Strip -->
        <div class="h-1.5 w-full bg-gradient-to-r from-cyan-500 via-sky-400 to-blue-600"></div>

        <div class="p-6 sm:p-7 flex-grow">
          <!-- Card Header & Badge -->
          <div class="flex items-center justify-between mb-4">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-cyan-500/15 border border-cyan-500/40 font-mono text-[11px] text-cyan-300 uppercase font-black tracking-wide">
              <span>PC &amp; Mac • 120 FPS</span>
            </span>
            <div class="font-mono text-xs font-bold text-cyan-300 bg-black/40 px-2 py-0.5 rounded border border-white/10">
              Vulkan Engine
            </div>
          </div>

          <h3 class="text-2xl font-black text-white font-display mb-2 group-hover:text-cyan-300 transition-colors">
            Desktop PC Emulation
          </h3>

          <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-6">
            Play OverPeak on desktop with dedicated WASD movement, free-look crosshair mouse aiming, 4K Ultrawide monitor support, and silky-smooth 120Hz frame rates.
          </p>

          <!-- Spec Matrix Pills -->
          <div class="space-y-2.5 font-mono text-xs mb-8 bg-op-dark/60 p-4 rounded-xl border border-op-border">
            <div class="flex items-center justify-between pb-2 border-b border-op-border/50">
              <span class="text-slate-400">Tested Clients:</span>
              <span class="text-white font-bold">MuMuPlayer 12 / BlueStacks 5</span>
            </div>
            <div class="flex items-center justify-between pb-2 border-b border-op-border/50">
              <span class="text-slate-400">Target Framerate:</span>
              <span class="text-cyan-300 font-bold">60 FPS to 120 FPS Locked</span>
            </div>
            <div class="flex items-center justify-between pb-2 border-b border-op-border/50">
              <span class="text-slate-400">Input Support:</span>
              <span class="text-white font-bold">Keyboard + Mouse &amp; Xbox Pad</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-400">Resolution Cap:</span>
              <span class="text-white font-bold">Native 1440p / 4K Ultrawide</span>
            </div>
          </div>
        </div>

        <!-- Action Button Section -->
        <div class="p-6 sm:p-7 pt-0">
          <a
            href="/pc/"
            class="w-full py-3.5 px-4 rounded-xl bg-op-dark border border-cyan-500/50 hover:bg-cyan-950/30 text-cyan-200 hover:text-white font-mono font-black text-xs uppercase tracking-wider text-center block transition-all flex items-center justify-center gap-2"
          >
            <span>Open PC Setup &amp; Keybinds →</span>
          </a>
        </div>
      </div>

      <!-- Card 3: Apple iOS (Evergreen Platform Notice) -->
      <div id="ios" class="relative rounded-2xl bg-gradient-to-b from-op-card via-op-card to-op-dark border border-op-border hover:border-slate-500 transition-all duration-300 flex flex-col justify-between shadow-lg group overflow-hidden">
        <!-- Top Accent Strip -->
        <div class="h-1.5 w-full bg-slate-700"></div>

        <div class="p-6 sm:p-7 flex-grow">
          <!-- Card Header & Badge -->
          <div class="flex items-center justify-between mb-4">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 border border-white/15 font-mono text-[11px] text-slate-300 uppercase font-bold tracking-wide">
              <span>Apple iOS Platform</span>
            </span>
            <div class="font-mono text-xs text-slate-400 bg-black/40 px-2 py-0.5 rounded border border-white/10">
              iPhone / iPad
            </div>
          </div>

          <h3 class="text-2xl font-black text-white font-display mb-2 group-hover:text-slate-200 transition-colors">
            Apple App Store
          </h3>

          <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-6">
            The native iOS build is currently under development by R-USER Games for iPhone and iPad devices powered by Apple Metal 3. Players on iOS can play immediately on PC or Mac via desktop emulation.
          </p>

          <!-- Evergreen Spec Overview -->
          <div class="space-y-2.5 font-mono text-xs mb-8 bg-op-dark/60 p-4 rounded-xl border border-op-border text-slate-300">
            <div class="flex items-center justify-between pb-2 border-b border-op-border/50">
              <span class="text-slate-400">Target Devices:</span>
              <span class="text-white font-bold">iPhone 11 through 16 Pro, iPad</span>
            </div>
            <div class="flex items-center justify-between pb-2 border-b border-op-border/50">
              <span class="text-slate-400">Graphics Engine:</span>
              <span class="text-white font-bold">Apple Metal 3</span>
            </div>
            <div class="flex items-center justify-between pb-2 border-b border-op-border/50">
              <span class="text-slate-400">Availability:</span>
              <span class="text-amber-400 font-bold">Developer Distribution</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-400">Desktop Alternative:</span>
              <span class="text-cyan-300 font-bold">macOS & Windows Emulators</span>
            </div>
          </div>
        </div>

        <!-- Action Button Section -->
        <div class="p-6 sm:p-7 pt-0">
          <a
            href="/pc/"
            class="w-full py-3.5 px-4 rounded-xl bg-op-dark border border-op-border hover:border-slate-500 text-slate-300 hover:text-white font-mono font-bold text-xs uppercase tracking-wider text-center block transition-all"
          >
            <span>Play on Desktop PC / Mac Now →</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- High-Tech Hardware Requirements Comparison Matrix -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-op-border">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-8">
      <div>
        <div class="font-mono text-xs text-orange-400 font-bold uppercase tracking-wider mb-1">
          BENCHMARK &amp; COMPATIBILITY
        </div>
        <h2 class="text-2xl sm:text-3xl font-black text-white font-display uppercase tracking-tight">
          System Requirements Matrix
        </h2>
      </div>
      <p class="font-mono text-xs text-slate-400">
        Validated on real-world mobile devices &amp; desktop configurations
      </p>
    </div>

    <div class="overflow-x-auto rounded-2xl border border-op-border bg-op-card shadow-2xl">
      <table class="w-full text-left font-mono text-xs border-collapse">
        <thead>
          <tr class="bg-op-dark border-b border-op-border text-slate-400 uppercase text-[11px]">
            <th class="p-4 sm:p-5 w-1/4">Hardware Component</th>
            <th class="p-4 sm:p-5 w-1/4">Minimum (Android 30 FPS)</th>
            <th class="p-4 sm:p-5 w-1/4 bg-orange-500/10 text-orange-300 border-x border-orange-500/30">
              <span class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-orange-400"></span>
                Recommended (Android 60 FPS)
              </span>
