---
import Layout from '../layouts/Layout.astro';

const pageTitle = 'Download OverPeak: Action Game – Android, PC & iOS Portals';
const pageDescription = 'Official verified download portal for OverPeak: Action Game by R-USER Games. Access the Google Play Store build, PC 120 FPS emulator setup, iOS status, and system requirements.';

const downloadSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://overpeakgame.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Download",
          "item": "https://overpeakgame.com/download/"
        }
      ]
    },
    {
      "@type": "SoftwareApplication",
      "name": "OverPeak: Action Game",
      "operatingSystem": "Android 9.0+, Windows 10/11 (via 64-bit Emulator)",
      "applicationCategory": "GameApplication",
      "downloadUrl": "https://play.google.com/store/apps/details?id=com.rusergames.overpeak&hl=en",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is OverPeak: Action Game completely free to play?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, OverPeak is 100% free to download and play from the official Google Play Store with no mandatory paywalls to complete the storyline."
          }
        },
        {
          "@type": "Question",
          "name": "Can OverPeak be played offline without internet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, once downloaded and installed, all open-world sandbox mechanics, real-time building destruction physics, and story missions run completely offline on your device."
          }
        },
        {
          "@type": "Question",
          "name": "Are OverPeak Mod APK downloads safe?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Modified APK files from unauthorized third-party sites frequently bundle adware, spyware, and permission exploits. We strongly advise playing only the verified Google Play Store build."
          }
        },
        {
          "@type": "Question",
          "name": "Can I play OverPeak on PC with keyboard and mouse?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Players can enjoy OverPeak immediately at 60–120 FPS using 64-bit Android emulators like MuMuPlayer 12 or BlueStacks 5 with custom WASD and mouse aiming controls."
          }
        }
      ]
    }
  ]
};
---

<Layout title={pageTitle} description={pageDescription} schema={downloadSchema}>

  <!-- Clean Page Header (Matching Homepage Style) -->
  <section class="border-b border-op-border bg-gradient-to-b from-op-darkest via-op-dark to-op-darkest py-10 sm:py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="font-mono text-xs text-slate-400 mb-4 flex items-center gap-2">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-white">Download &amp; Platforms</span>
      </nav>

      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-op-card border border-op-border text-[11px] font-mono text-slate-300 uppercase tracking-wider mb-4">
          <span class="w-2 h-2 rounded-full bg-op-green"></span>
          <span>Official Distribution Directory</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black text-white font-display uppercase tracking-tight mb-3">
          Download OverPeak: Action Game
        </h1>

        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          Access verified storefront downloads for Android mobile, desktop PC emulation setup, and platform compatibility guides. 100% free to play with full offline single-player support.
        </p>
      </div>

    </div>
  </section>

  <!-- Platform Cards Grid (Clean, Uniform, Authentic Game Portal Cards) -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-8">
      <h2 class="text-2xl font-black text-white font-display uppercase tracking-tight mb-1">
        Official Platform Portals
      </h2>
      <p class="text-slate-400 text-xs font-mono">
        Select your gaming device and hardware configuration
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Card 1: Android Google Play -->
      <div id="android" class="p-6 sm:p-8 rounded-2xl bg-op-card border border-op-border hover:border-slate-500 transition-all flex flex-col justify-between shadow-lg">
        <div>
          <div class="flex items-center justify-between mb-4 font-mono text-xs text-slate-400">
            <span class="px-2.5 py-1 rounded bg-op-dark border border-op-border text-slate-300 font-semibold">
              Android Edition
            </span>
            <span>4.2 ★ (8.2k)</span>
          </div>

          <h3 class="text-xl sm:text-2xl font-bold text-white font-display mb-2">
            Google Play Store
          </h3>

          <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-6">
            The official release published directly by <strong>R-USER Games</strong>. Includes unscripted voxel building destruction, open-world missions, touch optimization, and seamless offline play.
          </p>

          <ul class="space-y-2.5 font-mono text-xs text-slate-300 border-t border-op-border/60 pt-4 mb-8">
            <li class="flex items-center justify-between">
              <span class="text-slate-400">Package:</span>
              <span class="text-white font-semibold">com.rusergames.overpeak</span>
            </li>
            <li class="flex items-center justify-between">
              <span class="text-slate-400">Compatibility:</span>
              <span class="text-white">Android 9.0+</span>
            </li>
            <li class="flex items-center justify-between">
              <span class="text-slate-400">Install Size:</span>
              <span class="text-white">~1.2 GB</span>
            </li>
            <li class="flex items-center justify-between">
              <span class="text-slate-400">Connectivity:</span>
              <span class="text-white">100% Offline Capable</span>
            </li>
          </ul>
        </div>

        <div>
          <!-- Authentic Black Google Play Button (Identical to Homepage) -->
          <a
            href="https://play.google.com/store/apps/details?id=com.rusergames.overpeak&hl=en"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 px-5 py-3 rounded-xl bg-black border border-white/20 hover:border-white/50 text-white transition-all shadow-md group w-full"
          >
            <svg class="w-6 h-6 flex-shrink-0" viewBox="0 0 24 24" fill="none">
              <path d="M3.6 1.7L13.7 12 3.6 22.3c-.4-.3-.6-.8-.6-1.4V3.1c0-.6.2-1.1.6-1.4z" fill="#00E5FF"/>
              <path d="M17.1 8.6L13.7 12l3.4 3.4 3.9-2.2c1.1-.6 1.1-1.7 0-2.4l-3.9-2.2z" fill="#FFD600"/>
              <path d="M3.6 1.7l10.1 10.3 3.4-3.4L6.2.7C5.1.1 4.1.4 3.6 1.7z" fill="#00E676"/>
              <path d="M3.6 22.3l13.5-7.7-3.4-3.4L3.6 22.3z" fill="#FF3D00"/>
            </svg>
            <div class="text-left font-sans">
              <div class="text-[9px] text-slate-400 uppercase tracking-wider font-mono">Get it on</div>
              <div class="text-xs font-bold leading-tight">Google Play</div>
            </div>
          </a>
        </div>
      </div>

      <!-- Card 2: Desktop PC Emulation -->
      <div id="pc-platform" class="p-6 sm:p-8 rounded-2xl bg-op-card border border-op-border hover:border-slate-500 transition-all flex flex-col justify-between shadow-lg">
        <div>
          <div class="flex items-center justify-between mb-4 font-mono text-xs text-slate-400">
            <span class="px-2.5 py-1 rounded bg-op-dark border border-op-border text-slate-300 font-semibold">
              PC &amp; Mac Edition
            </span>
            <span>Vulkan 120 FPS</span>
          </div>

          <h3 class="text-xl sm:text-2xl font-bold text-white font-display mb-2">
            Desktop PC Emulation
          </h3>

          <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-6">
            Play OverPeak on desktop with dedicated WASD movement, free-look crosshair mouse aiming, 4K Ultrawide monitor support, and silky-smooth 120Hz frame rates.
          </p>

          <ul class="space-y-2.5 font-mono text-xs text-slate-300 border-t border-op-border/60 pt-4 mb-8">
            <li class="flex items-center justify-between">
              <span class="text-slate-400">Recommended:</span>
              <span class="text-white">MuMuPlayer 12 / BlueStacks 5</span>
            </li>
            <li class="flex items-center justify-between">
              <span class="text-slate-400">Graphics Engine:</span>
              <span class="text-white">Vulkan API</span>
            </li>
            <li class="flex items-center justify-between">
              <span class="text-slate-400">Controls:</span>
              <span class="text-white">WASD + Free Mouse Look</span>
            </li>
            <li class="flex items-center justify-between">
              <span class="text-slate-400">Gamepad:</span>
              <span class="text-white">Xbox &amp; DualSense</span>
            </li>
          </ul>
        </div>

        <div>
          <a
            href="/pc/"
            class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-op-dark border border-op-border hover:border-slate-400 text-white font-mono text-xs uppercase font-semibold transition-all w-full"
          >
            <span>Open PC Setup &amp; Keybinds →</span>
          </a>
        </div>
      </div>

      <!-- Card 3: Apple iOS Platform -->
      <div id="ios" class="p-6 sm:p-8 rounded-2xl bg-op-card border border-op-border hover:border-slate-500 transition-all flex flex-col justify-between shadow-lg">
        <div>
          <div class="flex items-center justify-between mb-4 font-mono text-xs text-slate-400">
            <span class="px-2.5 py-1 rounded bg-op-dark border border-op-border text-slate-300 font-semibold">
              Apple iOS
            </span>
            <span>iPhone / iPad</span>
          </div>

          <h3 class="text-xl sm:text-2xl font-bold text-white font-display mb-2">
            Apple App Store
          </h3>

          <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-6">
            The native iOS build is currently under development by R-USER Games for iPhone and iPad devices powered by Apple Metal 3. Players on iOS can play immediately on PC or Mac via desktop emulation.
          </p>

          <ul class="space-y-2.5 font-mono text-xs text-slate-300 border-t border-op-border/60 pt-4 mb-8">
            <li class="flex items-center justify-between">
              <span class="text-slate-400">Target Devices:</span>
              <span class="text-white">iPhone 11 through 16 Pro, iPad</span>
            </li>
            <li class="flex items-center justify-between">
              <span class="text-slate-400">Graphics Engine:</span>
              <span class="text-white">Apple Metal 3</span>
            </li>
            <li class="flex items-center justify-between">
              <span class="text-slate-400">Status:</span>
              <span class="text-white">In Development</span>
            </li>
            <li class="flex items-center justify-between">
              <span class="text-slate-400">Alternative:</span>
              <span class="text-white">Desktop PC Emulation</span>
            </li>
          </ul>
        </div>

        <div>
          <a
            href="/pc/"
            class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-op-dark border border-op-border hover:border-slate-400 text-slate-300 hover:text-white font-mono text-xs uppercase font-semibold transition-all w-full"
          >
            <span>Play on Desktop PC / Mac →</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- Clean Hardware Requirements Table -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-op-border">
    <div class="mb-8">
      <h2 class="text-2xl font-black text-white font-display uppercase tracking-tight mb-1">
        System Requirements &amp; Hardware Specs
      </h2>
      <p class="text-slate-400 text-xs font-mono">
        Validated hardware requirements for mobile and desktop emulation
      </p>
    </div>

    <div class="overflow-x-auto rounded-2xl border border-op-border bg-op-card shadow-lg">
      <table class="w-full text-left font-mono text-xs border-collapse">
        <thead>
          <tr class="bg-op-dark border-b border-op-border text-slate-400 uppercase text-[11px]">
            <th class="p-4 sm:p-5 w-1/4">Hardware Component</th>
            <th class="p-4 sm:p-5 w-1/4">Minimum (Android 30 FPS)</th>
            <th class="p-4 sm:p-5 w-1/4 text-white">Recommended (Android 60 FPS)</th>
            <th class="p-4 sm:p-5 w-1/4">Desktop PC (120 FPS Emulator)</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-op-border/50 text-slate-300">
          <tr class="hover:bg-white/5 transition-colors">
            <td class="p-4 sm:p-5 text-white font-bold">Operating System</td>
            <td class="p-4 sm:p-5">Android 9.0 (Pie)</td>
            <td class="p-4 sm:p-5 text-white">Android 12 or newer</td>
            <td class="p-4 sm:p-5">Windows 10 / 11 (64-bit)</td>
          </tr>
          <tr class="hover:bg-white/5 transition-colors">
            <td class="p-4 sm:p-5 text-white font-bold">Processor (CPU)</td>
            <td class="p-4 sm:p-5">Snapdragon 680 / Helio G88</td>
            <td class="p-4 sm:p-5 text-white">Snapdragon 8 Gen 1 / Dimensity 8200</td>
            <td class="p-4 sm:p-5">Intel Core i5-10400 / AMD Ryzen 5 3600</td>
          </tr>
          <tr class="hover:bg-white/5 transition-colors">
            <td class="p-4 sm:p-5 text-white font-bold">Graphics (GPU)</td>
            <td class="p-4 sm:p-5">Adreno 610 / Mali-G52</td>
            <td class="p-4 sm:p-5 text-white">Adreno 730 / Mali-G710</td>
            <td class="p-4 sm:p-5">NVIDIA GTX 1660 / AMD RX 580+</td>
          </tr>
          <tr class="hover:bg-white/5 transition-colors">
            <td class="p-4 sm:p-5 text-white font-bold">System Memory (RAM)</td>
            <td class="p-4 sm:p-5">4 GB RAM</td>
            <td class="p-4 sm:p-5 text-white">8 GB RAM</td>
            <td class="p-4 sm:p-5">16 GB RAM (6GB+ assigned to emulator)</td>
          </tr>
          <tr class="hover:bg-white/5 transition-colors">
            <td class="p-4 sm:p-5 text-white font-bold">Storage Drive</td>
            <td class="p-4 sm:p-5">2.5 GB Free Space</td>
            <td class="p-4 sm:p-5 text-white">4.0 GB Free Space</td>
            <td class="p-4 sm:p-5">10 GB Free SSD Space</td>
          </tr>
          <tr class="hover:bg-white/5 transition-colors">
            <td class="p-4 sm:p-5 text-white font-bold">Control Schemes</td>
            <td class="p-4 sm:p-5">On-Screen Dual Touch Sticks</td>
            <td class="p-4 sm:p-5 text-white">Touch + Bluetooth Gamepad</td>
            <td class="p-4 sm:p-5">WASD Keyboard + Mouse Look / Gamepad</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Download FAQ Section -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-op-border">
    <div class="mb-8">
      <h2 class="text-2xl font-black text-white font-display uppercase tracking-tight mb-1">
        Frequently Asked Questions
      </h2>
      <p class="text-slate-400 text-xs font-mono">
        Official installation and platform details
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      
      <div class="p-6 rounded-2xl bg-op-card border border-op-border">
        <h3 class="text-white font-bold text-base mb-2 font-display">
          Is OverPeak: Action Game completely free to play?
        </h3>
        <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
          Yes. OverPeak is free to install from the Google Play Store. The full sandbox campaign, physics destruction engine, and superpowers are fully unlocked through organic gameplay progression without any paywalls.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-op-card border border-op-border">
        <h3 class="text-white font-bold text-base mb-2 font-display">
          Does OverPeak work offline without WiFi or mobile data?
        </h3>
        <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
          Yes. After initial game installation from Google Play, all missions, combat physics, building destruction, and character upgrades function 100% offline without requiring continuous internet connectivity.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-op-card border border-op-border">
        <h3 class="text-white font-bold text-base mb-2 font-display">
          Are OverPeak Mod APK downloads safe?
        </h3>
        <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
          No. Pirated APK files from third-party download mirrors often carry malware, trojans, and intrusive ad-injectors. R-USER Games regularly patches the game, so modified clients will not receive official bug fixes or content updates.
        </p>
      </div>

      <div class="p-6 rounded-2xl bg-op-card border border-op-border">
        <h3 class="text-white font-bold text-base mb-2 font-display">
          Can OverPeak be played on Apple iOS?
        </h3>
        <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
          The native iOS edition is currently in development for iPhone and iPad on Apple Metal 3. Players looking to play immediately can run the full Android version on PC or Mac using desktop emulators like MuMuPlayer 12.
        </p>
      </div>

    </div>
  </section>

</Layout>
