---
import Layout from '../layouts/Layout.astro';

const pageTitle = 'How to Play OverPeak on PC – 60-120 FPS Setup, Controls & Keybinds';
const pageDescription = 'Complete guide on running OverPeak: Action Game on PC and Mac. Best emulator settings for 60-120 FPS, keyboard & mouse layout, and Xbox/DualSense controller mapping.';

const pcSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://overpeakgame.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "PC Setup",
          "item": "https://overpeakgame.com/pc/"
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "How to Configure and Play OverPeak on PC at 60-120 FPS",
      "description": "Step-by-step instructions for configuring Android emulation, Vulkan graphics, and custom keyboard/mouse keybindings for OverPeak on desktop.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Install a 64-bit Android Emulator",
          "text": "Download and install MuMuPlayer 12 (recommended for Vulkan) or BlueStacks 5 (Pie 64-bit instance)."
        },
        {
          "@type": "HowToStep",
          "name": "Download OverPeak from Google Play",
          "text": "Sign in to your Google Account inside the emulator, search for OverPeak: Action Game by R-USER Games, and click Install."
        },
        {
          "@type": "HowToStep",
          "name": "Configure Performance and Graphics Engine",
          "text": "Allocate 4 CPU cores and 6GB+ RAM, select Vulkan rendering, and enable 120 FPS High Frame Rate mode."
        },
        {
          "@type": "HowToStep",
          "name": "Map Keyboard & Mouse Keybindings",
          "text": "Assign WASD for movement, Right-Click for free mouse look aim, and Spacebar for flight and jumps."
        }
      ]
    }
  ]
};

const keybinds = [
  { action: 'Movement (Sprint / Walk)', pcKey: 'W / A / S / D', controller: 'Left Analog Stick (L3)' },
  { action: 'Camera Free Look', pcKey: 'Mouse Movement', controller: 'Right Analog Stick (R3)' },
  { action: 'Basic Punch / Melee', pcKey: 'Left Mouse Button', controller: 'Right Trigger (RT / R2)' },
  { action: 'Thermal Laser Aim & Fire', pcKey: 'Right Mouse Button (Hold)', controller: 'Left Trigger (LT / L2)' },
  { action: 'Super Jump / Ascend Flight', pcKey: 'Spacebar', controller: 'A / Cross Button' },
  { action: 'Air Dash / Ground Slam', pcKey: 'Left Shift (Double-Tap)', controller: 'B / Circle Button' },
  { action: 'Cryo Freeze Ray', pcKey: 'Q Key', controller: 'X / Square Button' },
  { action: 'Telekinetic Object Grab', pcKey: 'E Key', controller: 'Y / Triangle Button' },
  { action: 'Pause / Options Menu', pcKey: 'Escape (ESC)', controller: 'Start / Menu Button' },
];
---

<Layout title={pageTitle} description={pageDescription} schema={pcSchema}>

  <!-- Page Header with Game Atmosphere -->
  <section class="border-b border-op-border bg-op-darkest relative overflow-hidden py-12">
    <div class="absolute inset-0 opacity-10 bg-cover bg-center pointer-events-none" style="background-image: url('/images/pc-setup.jpg');"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-op-darkest via-op-darkest/90 to-transparent"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <nav class="font-mono text-xs text-slate-400 mb-6 flex items-center gap-2">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-white">PC Setup &amp; Controls</span>
      </nav>

      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded bg-white/5 border border-white/10 text-xs font-mono text-slate-300 mb-3">
          <span>Desktop Performance Guide</span>
          <span>• 60 to 120 FPS</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-black text-white font-display uppercase tracking-tight mb-4">
          How to Play OverPeak on PC &amp; Mac
        </h1>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          While R-USER Games develops a native PC version, desktop players can experience <strong>OverPeak</strong> with precision mouse aiming, ultrawide monitor resolutions, and smooth 120Hz frame rates today.
        </p>
      </div>

    </div>
  </section>

  <!-- Technical Overview Box (Clean Editorial Guide) -->
  <section class="py-8 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="p-6 sm:p-8 rounded-2xl bg-op-card border border-op-border">
      <span class="font-mono text-xs text-slate-400 uppercase tracking-wider block mb-1">
        TECHNICAL SPECIFICATION // EMULATION &amp; BENCHMARK
      </span>
      <h2 class="text-xl sm:text-2xl font-black text-white font-display mb-2">
        Playing OverPeak: Action Game on PC
      </h2>
      <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-3">
        While developer R-USER Games is actively developing an official standalone PC port, OverPeak is fully playable on Windows 10/11 and macOS today using 64-bit Android emulators like <strong>MuMuPlayer 12</strong> or <strong>BlueStacks 5</strong>. Desktop players achieve <strong>60 to 120 FPS</strong> at 1440p/4K resolutions using the Vulkan graphics renderer, with native support for WASD keyboard/mouse free-look aiming and Xbox/DualSense controller vibration.
      </p>
      <div class="flex flex-wrap gap-4 font-mono text-xs text-slate-400 pt-3 border-t border-op-border/50">
        <div><strong class="text-slate-200">Recommended Emulator:</strong> MuMuPlayer 12 (Vulkan API)</div>
        <div><strong class="text-slate-200">Target Hardware:</strong> 4+ CPU Cores, 8GB RAM, GTX 1660 / RX 580+</div>
      </div>
    </div>
  </section>

  <!-- Step-by-Step Installation Tutorial (Clean Monochrome Numbered Cards) -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-xl sm:text-2xl font-black text-white font-display uppercase tracking-tight mb-8">
      4-Step PC Setup Guide
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 font-mono text-xs">
      
      <!-- Step 1 -->
      <div class="p-6 rounded-2xl bg-op-card border border-op-border">
        <div class="w-8 h-8 rounded-lg bg-op-dark border border-op-border text-white font-bold flex items-center justify-center mb-4">
          01
        </div>
        <h3 class="text-white font-bold text-sm mb-2 font-sans">Choose Emulator</h3>
        <p class="text-slate-400 leading-relaxed">
          Download <strong>MuMuPlayer 12</strong> (recommended for Android 12 + Vulkan backend) or <strong>BlueStacks 5</strong> (create a 64-bit Pie or Android 11 instance).
        </p>
      </div>

      <!-- Step 2 -->
      <div class="p-6 rounded-2xl bg-op-card border border-op-border">
        <div class="w-8 h-8 rounded-lg bg-op-dark border border-op-border text-white font-bold flex items-center justify-center mb-4">
          02
        </div>
        <h3 class="text-white font-bold text-sm mb-2 font-sans">Install OverPeak</h3>
        <p class="text-slate-400 leading-relaxed">
          Launch Google Play Store inside the emulator, log in with your Google account, and search for <em>"OverPeak : Action Game"</em> by R-USER Games.
        </p>
      </div>

      <!-- Step 3 -->
      <div class="p-6 rounded-2xl bg-op-card border border-op-border">
        <div class="w-8 h-8 rounded-lg bg-op-dark border border-op-border text-white font-bold flex items-center justify-center mb-4">
          03
        </div>
        <h3 class="text-white font-bold text-sm mb-2 font-sans">Set 60–120 FPS</h3>
        <p class="text-slate-400 leading-relaxed">
          In emulator Settings &gt; Performance: assign <strong>4 Cores CPU</strong>, <strong>6GB+ RAM</strong>, select <strong>Vulkan</strong> renderer, and enable High Frame Rate.
        </p>
      </div>

      <!-- Step 4 -->
      <div class="p-6 rounded-2xl bg-op-card border border-op-border">
        <div class="w-8 h-8 rounded-lg bg-op-dark border border-op-border text-white font-bold flex items-center justify-center mb-4">
          04
        </div>
        <h3 class="text-white font-bold text-sm mb-2 font-sans">Configure Controls</h3>
        <p class="text-slate-400 leading-relaxed">
          Open the emulator Keyboard Mapping overlay and load the tactical FPS keybind profile below to lock mouse cursor for direct crosshair aiming.
        </p>
      </div>

    </div>

    <!-- Visual Showcase Banner: PC Battlestation & 120 FPS Setup -->
    <div class="mt-12 rounded-2xl overflow-hidden border border-op-border shadow-lg relative group">
      <img
        src="/images/pc-setup.jpg"
        alt="OverPeak PC Gaming Battlestation running at 120 FPS Ultrawide resolution with keyboard and mouse"
        width="1280"
        height="720"
        class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-700"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-op-darkest via-transparent to-transparent"></div>
      <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between font-mono text-xs">
        <div class="bg-black/80 backdrop-blur-md px-3 py-1.5 rounded-lg border border-white/10 text-white">
          <span>DESKTOP BATTLESTATION BENCHMARK</span>
          <span class="text-slate-400 ml-2">• 120 FPS Ultra-Wide Setup (WASD + Free Mouse Aim)</span>
        </div>
        <span class="hidden sm:inline-block px-2.5 py-1 rounded bg-white/10 border border-white/10 text-slate-300 font-bold text-[10px] uppercase">
          Vulkan 120Hz Verified
        </span>
      </div>
    </div>
  </section>

  <!-- Complete Keybinds Mapping Table (Clean Monochrome Table) -->
  <section id="controls" class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-op-border">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
      <div>
        <h2 class="text-xl sm:text-2xl font-black text-white font-display uppercase tracking-tight">
          Optimized PC Keybinds &amp; Controller Profile
        </h2>
        <p class="text-slate-400 text-xs font-mono mt-1">Recommended layout for mouse/keyboard and Xbox Wireless / DualSense controllers.</p>
      </div>
      <span class="px-2.5 py-1 rounded bg-white/5 border border-white/10 text-slate-300 font-mono text-xs font-bold self-start">
        Pre-Configured Profile
      </span>
    </div>

    <div class="overflow-x-auto rounded-2xl border border-op-border bg-op-card">
      <table class="w-full text-left font-mono text-xs">
        <thead class="bg-op-dark border-b border-op-border text-slate-400 uppercase">
          <tr>
            <th class="p-4">Game Combat Action</th>
            <th class="p-4">PC Keyboard &amp; Mouse</th>
            <th class="p-4">Gamepad Controller</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-op-border/50 text-slate-300">
          {keybinds.map((bind) => (
            <tr class="hover:bg-white/5 transition-colors">
              <td class="p-4 text-white font-semibold">{bind.action}</td>
              <td class="p-4">
                <code class="px-2 py-1 rounded bg-op-dark border border-op-border text-white font-bold">
                  {bind.pcKey}
                </code>
              </td>
              <td class="p-4 text-slate-300">{bind.controller}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- PC Performance Tuning Tips -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-t border-op-border">
    <div class="p-8 rounded-2xl bg-op-card border border-op-border">
      <h3 class="text-lg font-bold text-white mb-4 font-display uppercase tracking-tight">
        Fixing Stuttering &amp; Latency on Desktop
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs font-mono text-slate-300">
        <div>
          <h4 class="text-white font-bold mb-1">1. Switch from OpenGL to Vulkan</h4>
          <p class="text-slate-400 leading-relaxed">
            OverPeak's particle-heavy building collapse physics can bottleneck OpenGL drivers on Windows. Switching to the Vulkan rendering engine inside emulator settings reduces frame drops by up to 45%.
          </p>
        </div>
        <div>
          <h4 class="text-white font-bold mb-1">2. Enable Hardware Virtualization (VT-x / AMD-V)</h4>
          <p class="text-slate-400 leading-relaxed">
            Ensure CPU virtualization is enabled in your motherboard BIOS. Without VT-x enabled, Android emulation is restricted to single-thread software interpretation, causing massive stutter.
          </p>
        </div>
      </div>
    </div>
  </section>

</Layout>
